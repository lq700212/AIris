<!--
  存档详情弹窗（设计稿 dlg-shot）：存档截图 + 判定数据 + 完整追溯信息。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.ShotDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="存档详情" Width="680" SizeToContent="Height" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource Brush.Fresh.CardBg}" Padding="18,14,18,16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="存档详情" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                <TextBlock x:Name="Badge" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,1,0,0"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="225" CornerRadius="10" Background="{DynamicResource ThemePanel2Bg}" ClipToBounds="True">
                    <Image x:Name="ShotImage" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="2" TextElement.FontSize="12">
                    <TextBlock x:Name="VerdictText" FontWeight="Bold"/>
                    <TextBlock x:Name="StepText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RoiText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="RuleText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="EngineText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="FileText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="关闭" Style="{DynamicResource FreshButton}" FontSize="12.5" Padding="16,7" Margin="0,0,10,0" Cursor="Hand" Click="Close_Click"/>
                <Button Content="导出此条" Style="{DynamicResource FreshPrimaryButton}" FontSize="12.5" Padding="16,7" Cursor="Hand" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
