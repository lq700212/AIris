<!--
  通用确认弹窗（删除配方 / 引擎切换 / 信息提示复用——设计稿 dlg-del / dlg-switch 的通用化）。
  danger=true 时确认钮红色（删除类）；hideCancel=true 时只留确认钮（信息提示态）。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.ConfirmDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="确认" Width="440" SizeToContent="Height" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource Brush.Fresh.CardBg}" Padding="18,14,18,16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
            <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{DynamicResource ThemeTextMuted}"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource FreshButton}" FontSize="12.5" Padding="16,7" Margin="0,0,10,0"
                        Cursor="Hand" Click="Cancel_Click"/>
                <Button x:Name="ConfirmBtn" Content="确认" Style="{DynamicResource FreshPrimaryButton}" FontSize="12.5" Padding="16,7"
                        Cursor="Hand" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
