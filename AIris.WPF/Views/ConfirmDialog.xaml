<!--
  通用确认弹窗（删除配方 / 引擎切换 / 信息提示复用——设计稿 dlg-del / dlg-switch 的通用化）。
  danger=true 时确认钮红实底（AiBtnDanger 药丸，颜色走 ThemeNg 随主题）；hideCancel=true 时
  只留确认钮（信息提示态）。

  2026-11-23 整改：按钮从库 FreshButton（CornerRadius=4 方角）换成宿主 AiBtn* 药丸 999，
  根底从 Brush.Fresh.CardBg（库浅色键板，深色模式不跟随）换成 ThemePanelBg。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.ConfirmDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="确认" Width="440" SizeToContent="Height" UseLayoutRounding="True" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource ThemePanelBg}" Padding="18,14,18,16">
        <StackPanel>
            <!-- 标题条已显示同一句标题：内容区不再重复大标题，直接正文（2026-11-23 统一口径） -->
            <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{DynamicResource ThemeTextMuted}"
                       TextWrapping="Wrap"/>
            <!-- 设计稿 .mf：右对齐 + 上方 1px 分隔线（通用确认/提示弹窗统一口径） -->
            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource AiBtnSecondary}"
                            Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmBtn" Content="确认" Style="{StaticResource AiBtnPrimary}"
                            Click="Confirm_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
