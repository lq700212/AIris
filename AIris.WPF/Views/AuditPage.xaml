<!--
  审计追溯（设计稿 data-page="audit" · C 方案）

  ┌ 页头：▦ 审计追溯 · [← 返回] [导出 Excel(primary)] ┐
  │ 筛选行：日期 / 判定下拉 / [查询]                    │
  │ KPI：今日判定 / OK / NG / 存档条数                  │
  │ 记录表：时间/SN/工步/区域/判定/详情⋯（NG 行左红条）  │
  └─────────────────────────────────────────────────────┘
-->
<UserControl x:Class="AIris.WPF.Views.AuditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▦ 审计追溯" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                <TextBlock Text="每一步判定自动截图存档，客诉举证直接调档" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="14,1,0,0"/>
            </StackPanel>
            <Button Content="← 返回监控台" Command="{Binding BackCommand}" Style="{DynamicResource FreshButton}"
                    FontSize="12" Padding="14,7" Cursor="Hand" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 筛选行 -->
        <Border Grid.Row="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="130"
                         Style="{DynamicResource FreshInput}" FontSize="12" Padding="10,0" VerticalAlignment="Center"
                         ToolTip="yyyy-MM-dd，留空查全部"/>
                <ComboBox SelectedIndex="{Binding VerdictIndex}" Width="110" Style="{DynamicResource FreshCombo}"
                          FontSize="12" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <ComboBoxItem>全部判定</ComboBoxItem>
                    <ComboBoxItem>OK</ComboBoxItem>
                    <ComboBoxItem>NG</ComboBoxItem>
                </ComboBox>
                <Button Content="查询" Command="{Binding QueryCommand}" Style="{DynamicResource FreshPrimaryButton}"
                        FontSize="12" Padding="16,6" Margin="10,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="14" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="查询命中" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                    <TextBlock Text="{Binding TotalCount, FallbackValue=0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="14" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="OK" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                    <TextBlock Text="{Binding OkCount, FallbackValue=0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeOk}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="14" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="NG" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                    <TextBlock Text="{Binding NgCount, FallbackValue=0}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeNg}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="14" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="追溯能力" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                    <TextBlock Text="截图 + 规则快照" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 记录表 -->
        <Border Grid.Row="3" Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView Grid.Row="1" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="86" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="SN" Width="150" DisplayMemberBinding="{Binding Sn}"/>
                            <GridViewColumn Header="工步" Width="220" DisplayMemberBinding="{Binding Step}"/>
                            <GridViewColumn Header="区域" Width="90" DisplayMemberBinding="{Binding RoiId}"/>
                            <GridViewColumn Header="判定" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VerdictDetail}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNg}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="详情" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⋯" Style="{DynamicResource FreshButton}" FontSize="11" Padding="8,2"
                                                Cursor="Hand" Click="Shot_Click" ToolTip="存档详情（截图 + 判定依据）"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1" Text="暂无存档记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextMuted}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, FallbackValue=0}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="2" Text="单次最多 500 条 · 存档目录 Data\Audit\（JSONL 按天 + Shots\ 截图）"
                           FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="14,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
