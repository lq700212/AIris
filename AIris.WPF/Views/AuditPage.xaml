<!--
  审计追溯（设计稿 data-page="audit" · C 方案）

  ┌ 页头：审计追溯 · 每一步判定自动截图存档                  [← 返回监控台] ┐
  ├ 筛选卡：日期(160) / 判定(160) / [查询]          右侧：存档目录说明       ┤
  ├ KPI 行：查询命中 / OK / NG / 追溯能力（4 列）                          ┤
  ├ 明细表卡：时间110 / SN170 / 工步* / 区域110 / 判定280 / 详情60          ┤
  └ 底部说明：单次最多 500 条 · Data\Audit\（JSONL 按天 + Shots\ 截图）    ┘

  表格实现口径（2026-11-23 整改）：由 ListView+GridView 改 Grid 自绘表格——
  GridViewColumn 不支持星号列（固定 86/150/220/90/240/60 在 1920 下右侧留大片空白），
  自绘 Grid + SharedSizeGroup 可让"工步"列吃掉剩余宽度，与设计稿列宽口径一致；
  行模板仍是 DataTemplate（按钮 Click 走页面 code-behind，行为不变）。
-->
<UserControl x:Class="AIris.WPF.Views.AuditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="审计追溯" Style="{StaticResource AiPageTitle}"/>
                <TextBlock Text="每一步判定自动截图存档，客诉举证直接调档" Style="{StaticResource AiPageSub}"/>
            </StackPanel>
            <Button Content="← 返回监控台" Command="{Binding BackCommand}"
                    Style="{StaticResource AiBtnSecondary}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 筛选卡 -->
        <Border Grid.Row="1" Style="{StaticResource AiCard}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="160"
                             Style="{StaticResource AiInput}" ToolTip="yyyy-MM-dd，留空查全部"/>
                    <ComboBox SelectedIndex="{Binding VerdictIndex}" Width="160"
                              Style="{StaticResource AiCombo}" Margin="12,0,0,0">
                        <sys:String>全部判定</sys:String>
                        <sys:String>仅 OK</sys:String>
                        <sys:String>仅 NG</sys:String>
                    </ComboBox>
                    <Button Content="查询" Command="{Binding QueryCommand}" MinHeight="32"
                            Style="{StaticResource AiBtnPrimarySm}" Padding="18,0" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="存档目录 Data\Audit\（JSONL 按天 + Shots\ 截图）" FontSize="10.5"
                           Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- KPI 4 列 -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="查询命中" Style="{StaticResource AiKpiLabel}"/>
                    <TextBlock Text="{Binding TotalCount, FallbackValue=0}" Style="{StaticResource AiKpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="OK" Style="{StaticResource AiKpiLabel}"/>
                    <TextBlock Text="{Binding OkCount, FallbackValue=0}" Style="{StaticResource AiKpiValue}"
                               Foreground="{DynamicResource ThemeOk}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="NG" Style="{StaticResource AiKpiLabel}"/>
                    <TextBlock Text="{Binding NgCount, FallbackValue=0}" Style="{StaticResource AiKpiValue}"
                               Foreground="{DynamicResource ThemeNg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AiKpi}">
                <StackPanel>
                    <TextBlock Text="追溯能力" Style="{StaticResource AiKpiLabel}"/>
                    <TextBlock Text="截图 + 规则快照" Style="{StaticResource AiKpiValueSm}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 明细表卡（Grid 自绘：表头固定 + 行滚动） -->
        <Border Grid.Row="3" Style="{StaticResource AiCard}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                        <TextBlock Grid.Column="1" Text="SN" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                        <TextBlock Grid.Column="2" Text="工步" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                        <TextBlock Grid.Column="3" Text="区域" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                        <TextBlock Grid.Column="4" Text="判定" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                        <TextBlock Grid.Column="5" Text="详情" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10"/>
                    </Grid>
                </Border>

                <!-- 行列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="14,0" Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11.5"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ThemeTextMuted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Sn}" FontSize="11.5"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ThemeTextFg}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Step}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ThemeTextFg}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RoiId}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ThemeTextMuted}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding VerdictDetail}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNg}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="5" Content="⋯" Style="{StaticResource AiBtnGhostSm}"
                                                    Width="34" Padding="0" HorizontalAlignment="Left"
                                                    Click="Shot_Click" ToolTip="存档详情（截图 + 判定依据）"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空态 -->
                        <TextBlock Text="暂无存档记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,60,0,0" Foreground="{DynamicResource ThemeTextMuted}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count, FallbackValue=0}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部说明（卡外一行小字，设计稿口径） -->
        <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="10.5"
                   Foreground="{DynamicResource ThemeTextMuted}">
            <Run Text="单次最多 500 条 · 存档目录 "/><Run Text="Data\Audit\" FontFamily="Consolas"
                 Foreground="{DynamicResource ThemePrimary}"/><Run Text="（JSONL 按天 + Shots\ 截图）"/>
        </TextBlock>
    </Grid>
</UserControl>
