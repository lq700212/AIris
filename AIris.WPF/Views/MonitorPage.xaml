<!--
  运行监控台（设计稿 data-page="monitor" · C 方案）

  ┌────────────────────────────────────────────┬──────────────────────┐
  │ 取像舞台卡（4:3 内接 + 检测框叠加 + 内嵌脚注）│ 当前工步引导卡        │
  │  KxImageStage（圆角裁剪）                    │  工步 7/7 · 判定胶囊  │
  │  检测框三态：橙=待装 / 绿=已装 / 黄虚线=等待   │  预期 / 判定规则行    │
  │  红=NG（vNext 设计稿口径，DrawBoxes 着色）    │  启动/暂停 + 引擎名   │
  │                                              ├──────────────────────┤
  │                                              │ NG 告警卡（红描边）   │
  │                                              ├──────────────────────┤
  │                                              │ 工步序列卡            │
  │                                              ├──────────────────────┤
  │                                              │ 运行日志（占满剩余）  │
  ├────────────────────────────────────────────┴──────────────────────┤
  │ 演示控制条（独立卡，Mock 三件套驱动；真机接入后隐藏）                  │
  └───────────────────────────────────────────────────────────────────┘

  布局口径（对齐设计稿）：
  · 主区两列 = minmax(0,1fr) + 400px，gap 16（旧版 1.45*:1* 在 1920 下右列 760 过宽）；
  · 舞台脚注 28px 高，叠在舞台内部底边（设计稿 .stage-foot），不再占卡片外一行；
  · 演示控制条整宽独立卡放最下方（设计稿 .page 底部），旧版塞在左列底部。
  语义红线：检测框标签永不显示置信度（AGENTS.md 铁律 12）。
-->
<UserControl x:Class="AIris.WPF.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 主区：左取像舞台 + 右 400px 信息列 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左：取像舞台卡（普通描边卡；舞台四角用 KxRoundedClip 裁圆） -->
            <Border Grid.Column="0" Style="{StaticResource AiCard}" Padding="6" ClipToBounds="True">
                <Grid>
                    <!-- 库 KxImageStage：舞台底/网格/扫描/帧图/空态/叠加画布全内置，
                         宿主只绑 FrameSource + IdleText，叠加框在 Stage.Overlay 上画 -->
                    <ui:KxImageStage x:Name="StageGrid" SizeChanged="Stage_SizeChanged"
                                     GridStep="64"
                                     FrameSource="{Binding FrameImage}" IdleText="等待画面…"
                                     GridVisibleWhenFrame="{Binding IsMockMode}"/>

                    <!-- 舞台脚注（设计稿 .stage-foot：28px 半透明条贴舞台底边） -->
                    <Border VerticalAlignment="Bottom" Height="28" CornerRadius="0,0,12,12"
                            Background="{DynamicResource ThemeStageFootBg}" Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CameraInfo}" FontSize="10.5"
                                           Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBlock Text="{Binding EngineNote}" FontSize="10.5" Margin="14,0,0,0"
                                           Foreground="{DynamicResource ThemeTextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="位置判定 = ROI-IoU 几何规则（不依赖模型理解位置）"
                                       FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右列：固定 400（设计稿 minmax 右列 400px） -->
            <Grid Grid.Column="2" x:Name="RightCol">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 当前工步引导卡（主操作：启动/暂停） -->
                <Border Grid.Row="0" Style="{StaticResource AiCard}" Padding="16,14,16,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding StepPos}" FontSize="11"
                                       Foreground="{DynamicResource ThemeTextMuted}"/>
                            <!-- 判定胶囊（设计稿 .chip：6px 圆点 + 22 高药丸） -->
                            <ContentControl HorizontalAlignment="Right">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipMut}">
                                        <Setter Property="Content" Value="判定中"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Verdict}" Value="ok">
                                                <Setter Property="Content" Value="判定 OK"/>
                                                <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="ng">
                                                <Setter Property="Content" Value="判定 NG"/>
                                                <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>

                        <TextBlock Text="{Binding StepName}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextFg}" Margin="0,8,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExpectLine}" FontSize="11.5"
                                   Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RuleLine}" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"/>

                        <!-- 主操作 + 引擎提示 -->
                        <Grid Margin="0,12,0,0">
                            <Button Command="{Binding StartPauseCommand}" Content="{Binding StartPauseText}"
                                    Style="{StaticResource AiBtnPrimary}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding EngineNote}" FontSize="10.5"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- NG 告警卡（红描边；NG 态可见） -->
                <Border Grid.Row="1" Style="{StaticResource AiCard}" BorderBrush="{DynamicResource ThemeNg}"
                        Padding="14,12,14,12" Margin="0,12,0,0"
                        Visibility="{Binding HasNg, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="工位判定 NG" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeNg}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource AiChipWarn}" Content="声光报警已触发"
                                                MinHeight="18" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="连续 3 次将通知班组长" FontSize="10.5"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding NgDetail}" FontSize="11.5" Margin="0,6,0,8"
                                   Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="NG 详情…" Style="{StaticResource AiBtnPrimarySm}"
                                    Click="NgDetail_Click"/>
                            <Button Content="重检本步" Command="{Binding RecheckCommand}"
                                    Style="{StaticResource AiBtnSecondarySm}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 工步序列卡 -->
                <Border Grid.Row="2" Style="{StaticResource AiCard}" Margin="0,12,0,0" Padding="16,14,16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="工步序列" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="{Binding Steps.Count, StringFormat=共 {0} 步}" Style="{StaticResource AiCardSub}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="8" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="current">
                                                        <Setter Property="Background" Value="{DynamicResource ThemePrimaryFill}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StateGlyph}" FontSize="11"
                                                       FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="done">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="current">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextFg}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="current">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding RoiId}" FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 运行日志卡（占满右列剩余高度） -->
                <Border Grid.Row="3" Style="{StaticResource AiCard}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12,16,10" BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="运行日志" Style="{StaticResource AiCardTitle}"/>
                                <TextBlock Grid.Column="1" FontSize="10.5" Margin="10,0,8,0"
                                           Foreground="{DynamicResource ThemeTextMuted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="状态："/><Run Text="{Binding StatusLine, Mode=OneWay}"/>
                                </TextBlock>
                                <ContentControl Grid.Column="2" MinHeight="20" FontSize="10.5"
                                                Style="{StaticResource AiChipOk}">
                                    <TextBlock>
                                        <Run Text="OK "/><Run Text="{Binding OkCount, Mode=OneWay}"/>
                                        <Run Text=" / NG "/><Run Text="{Binding NgCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </ContentControl>
                            </Grid>
                        </Border>

                        <!-- 日志流：等宽小字、级别着色、自动滚到底（code-behind glue） -->
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="14,2"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" LineHeight="17"
                                               FontFamily="Consolas, Microsoft YaHei UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeWarn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource ThemeTextFg}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Msg, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 底部演示控制条（仅 Mock 数据模式显示 · 独立整宽卡） =====
             真机 + 真实引擎时驱动 MockScene 没有意义，会误导成"点一下真机画面会变"，
             故按 IsMockMode 显隐（顶栏「Mock 数据」开关驱动）。 -->
        <Border Grid.Row="1" Style="{StaticResource AiCard}" Padding="14,10" Margin="0,14,0,0"
                Visibility="{Binding IsMockMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="演示控制" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"
                               Margin="2,0,10,0"/>
                    <ComboBox ItemsSource="{Binding DemoParts}" SelectedItem="{Binding SelectedPart}"
                              Width="150" MinHeight="30" Style="{StaticResource AiCombo}" VerticalAlignment="Center"/>
                    <Button Content="放上一个" Command="{Binding DemoPlaceCommand}"
                            Style="{StaticResource AiBtnSecondarySm}" Margin="10,0,0,0"/>
                    <Button Content="拿走一个（NG 模拟）" Command="{Binding DemoRemoveCommand}"
                            Style="{StaticResource AiBtnDangerGhostSm}" Margin="8,0,0,0"/>
                    <Button Content="一键摆齐" Command="{Binding DemoPlaceAllCommand}"
                            Style="{StaticResource AiBtnSecondarySm}" Margin="8,0,0,0"/>
                    <Button Content="重检本步" Command="{Binding RecheckCommand}"
                            Style="{StaticResource AiBtnPrimarySm}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="仅 Mock 数据模式可用 · 顶栏「Mock 数据」可随时开关" FontSize="10.5"
                           Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
