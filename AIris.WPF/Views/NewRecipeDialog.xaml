<!--
  新建配方向导（设计稿 dlg-new-recipe 两步合一：第 1 步描述产品 → 第 2 步 AI 预填工步草稿）。
  第 2 步按零件清单行数生成"预填工步草稿"列表（Mock 语义：MockDetectionEngine.ExtractKeyword
  能把行文本匹配到类目；真引擎下这段 prompt 直接进模型，草稿结构同样成立）。

  2026-11-23 整改：输入 FreshInput（方角 4）→ AiInput（高 34 / 圆角 10）；
  按钮 FreshButton → AiBtn* 药丸 999；根底 → ThemePanelBg（深色跟随宿主）。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.NewRecipeDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="新建配方" Width="600" SizeToContent="Height" UseLayoutRounding="True" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource ThemePanelBg}" Padding="18,14,18,16">
        <StackPanel>
            <!-- 步骤指示器（设计稿 .steps：18px 圆 + 数字 + 26px 连接线；当前步橙底白字）
                 标题条已有「新建配方」，内容区不再重复标题（2026-11-23 统一口径） -->
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot1" Width="18" Height="18" CornerRadius="999"
                            BorderThickness="1" Background="{DynamicResource ThemePrimaryGrad}"
                            BorderBrush="{DynamicResource ThemePrimary}">
                        <TextBlock x:Name="StepNum1" Text="1" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeOnPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLbl1" Text="产品信息" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextFg}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle x:Name="StepLine" Width="26" Height="1" Fill="{DynamicResource ThemeBorder}"
                           Margin="10,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot2" Width="18" Height="18" CornerRadius="999"
                            BorderThickness="1" Background="{DynamicResource ThemePanel2Bg}"
                            BorderBrush="{DynamicResource ThemeBorder}">
                        <TextBlock x:Name="StepNum2" Text="2" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepLbl2" Text="检测项目与工步" FontSize="11"
                               Foreground="{DynamicResource ThemeTextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== 第 1 步：产品描述 ===== -->
            <StackPanel x:Name="Step1Panel">
                <TextBlock Text="产品名称" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,14,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource AiInput}"
                         ToolTip="如：电动车控制器 V2.2"/>
                <TextBlock Text="零件清单（自然语言，顿号分隔）" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,12,0,4"/>
                <TextBox x:Name="PartsBox" Style="{StaticResource AiInput}"
                         ToolTip="如：金属垫板、M3 盘头螺丝 ×4、散热器、电容模块"/>
                <TextBlock Text="AI 按这句话预填工步草稿，之后在编辑器里逐项调整" FontSize="10.5"
                           Foreground="{DynamicResource ThemeTextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ===== 第 2 步：AI 预填工步草稿 ===== -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="AI 已按零件清单预填工步，创建后可在编辑器中调整顺序、ROI 与判定规则"
                           FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,14,0,8"/>
                <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="4,4" Margin="0,0,0,0">
                    <ItemsControl x:Name="DraftList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ThemeTextFg}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Rule}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="草稿不启用：标画完 ROI 再到配方中心启用" FontSize="10.5"
                           Foreground="{DynamicResource ThemeOk}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 底部按钮（设计稿 .mf：上方 1px 分隔线；取消/上一步 次按钮，下一步 主按钮） -->
            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button x:Name="PrevBtn" Content="上一步" Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0" Click="Prev_Click" Visibility="Collapsed"/>
                    <Button x:Name="NextBtn" Content="下一步" Style="{StaticResource AiBtnPrimary}" Click="Next_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
