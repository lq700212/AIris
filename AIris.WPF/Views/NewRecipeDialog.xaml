<!--
  新建配方向导（设计稿 dlg-new-recipe 两步合一：第 1 步描述产品 → 第 2 步 AI 预填工步草稿）。
  第 2 步按零件清单行数生成"预填工步草稿"列表（Mock 语义：MockDetectionEngine.ExtractKeyword
  能把行文本匹配到类目；真引擎下这段 prompt 直接进模型，草稿结构同样成立）。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.NewRecipeDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="新建配方" Width="600" SizeToContent="Height" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource Brush.Fresh.CardBg}" Padding="18,14,18,16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="新建配方" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                    <TextBlock x:Name="StepBadge" Text="第 1 步 · 描述产品" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,1,0,0"/>
                </StackPanel>
                <TextBlock Text="配方只描述「检什么」，不写代码" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- ===== 第 1 步：产品描述 ===== -->
            <StackPanel x:Name="Step1Panel">
                <TextBlock Text="产品名称" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,14,0,4"/>
                <TextBox x:Name="NameBox" Style="{DynamicResource FreshInput}" FontSize="13" Padding="10,0"
                         ToolTip="如：电动车控制器 V2.2"/>
                <TextBlock Text="零件清单（自然语言，顿号分隔）" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,12,0,4"/>
                <TextBox x:Name="PartsBox" Style="{DynamicResource FreshInput}" FontSize="13" Padding="10,0"
                         ToolTip="如：金属垫板、M3 盘头螺丝 ×4、散热器、电容模块"/>
                <TextBlock Text="AI 按这句话预填工步草稿，之后在编辑器里逐项调整" FontSize="10.5"
                           Foreground="{DynamicResource ThemeTextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ===== 第 2 步：AI 预填工步草稿 ===== -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="AI 已按零件清单预填工步，创建后可在编辑器中调整顺序、ROI 与判定规则"
                           FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,14,0,8"/>
                <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="10" Padding="4,4" Margin="0,0,0,0">
                    <ItemsControl x:Name="DraftList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ThemeTextFg}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Rule}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="草稿不启用：标画完 ROI 再到配方中心启用" FontSize="10.5"
                           Foreground="{DynamicResource ThemeOk}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource FreshButton}" FontSize="12.5" Padding="16,7" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click"/>
                <Button x:Name="PrevBtn" Content="上一步" Style="{DynamicResource FreshButton}" FontSize="12.5" Padding="16,7" Margin="0,0,10,0" Cursor="Hand" Click="Prev_Click" Visibility="Collapsed"/>
                <Button x:Name="NextBtn" Content="下一步" Style="{DynamicResource FreshPrimaryButton}" FontSize="12.5" Padding="16,7" Cursor="Hand" Click="Next_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
