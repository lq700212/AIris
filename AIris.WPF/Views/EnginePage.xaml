<!--
  检测引擎页（设计稿 data-page="engine" · C 方案）

  ┌ 页头：⚙ 检测引擎 · [引擎态]            [← 返回] [应用配置(primary)] ┐
  │ 引擎卡流：Mock 卡 / LocateAnything 卡(⚠ 仅研究) / Qwen2.5-VL 卡(✓ Apache)│
  │ 推理参数卡：解码模式 / 批处理 / 服务地址 / 模型名                        │
  │ 服务状态卡：显存 / 单帧耗时 / 今日调用（只读 KPI）                      │
  └────────────────────────────────────────────────────────────────────────┘
  许可证状态直接写在引擎卡上（避免误用——调研报告 §3 最大风险）。
-->
<UserControl x:Class="AIris.WPF.Views.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" xmlns:converters="clr-namespace:AIris.WPF.Converters"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙ 检测引擎" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                <Border CornerRadius="99" Background="{DynamicResource ThemePanel2Bg}" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineState}" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回监控台" Command="{Binding BackCommand}" Style="{DynamicResource FreshButton}"
                        FontSize="12" Padding="14,7" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="应用配置" Command="{Binding ApplyCommand}" Style="{DynamicResource FreshPrimaryButton}"
                        FontSize="12" Padding="16,7" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 引擎卡流 -->
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="460" Margin="0,0,14,14" CornerRadius="16" Padding="16"
                                    Background="{DynamicResource ThemePanelBg}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="99" Padding="9,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <!-- 许可证胶囊（引擎页核心信息） -->
                                    <Border CornerRadius="8" Background="{DynamicResource ThemeWarnDim}" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LicenseNote}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeWarn}"/>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run>开放词汇即指即检 · 归一化坐标框输出 · 判定走 ROI-IoU 几何规则</Run>
                                    </TextBlock>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="切换需重载引擎（Mock 演示不中断）" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                        <Button Content="{Binding SwitchText}" Command="{Binding SwitchCommand}" IsEnabled="{Binding SwitchEnabled}"
                                                Style="{DynamicResource FreshPrimaryButton}" FontSize="12" Padding="14,6"
                                                Cursor="Hand" HorizontalAlignment="Right"
                                                Visibility="{Binding Active, Converter={StaticResource InvBoolToVis}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 推理参数卡 -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,4,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="推理参数" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <TextBlock Text="改动需点右上「应用配置」" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="解码模式（LocateAnything PBD 三档）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <ComboBox SelectedItem="{Binding DecodeMode}" Style="{DynamicResource FreshCombo}" FontSize="12" Padding="10,7" Margin="0,4">
                                    <ComboBoxItem>fast（MTP）</ComboBoxItem>
                                    <ComboBoxItem>slow（AR）</ComboBoxItem>
                                    <ComboBoxItem>hybrid（MTP 优先）</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="批处理大小" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="HTTP 推理服务地址（接入真实引擎后生效）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding HttpBaseUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"
                                         ToolTip="如 http://127.0.0.1:8100（Linux 常驻推理服务 FastAPI/vLLM）"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="服务模型名" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding HttpModel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"
                                         ToolTip="如 locateanything-3b / qwen2.5-vl-7b"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 服务状态卡（只读） -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="服务状态" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <TextBlock Text="只读 · 随运行自动刷新" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="显存占用" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding MemoryNote, FallbackValue=—}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="单帧耗时" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}">
                                        <Run Text="{Binding LastMs, Mode=OneWay}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="累计调用" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding TotalCalls, FallbackValue=0}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeOk}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="当前引擎" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding ActiveEngineName, FallbackValue=—}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
