<!--
  检测引擎页（设计稿 data-page="engine" · C 方案）

  ┌ 页头：🧠 检测引擎 · [引擎态]            [← 返回] [应用配置(primary)] ┐
  │ 引擎卡流：Mock 卡 / LocateAnything 卡(⚠ 仅研究) / Qwen2.5-VL 卡(✓ Apache)│
  │ 推理参数卡：解码模式 / 批处理 / 服务地址 / 模型名                        │
  │ 服务状态卡：显存 / 单帧耗时 / 今日调用（只读 KPI）                      │
  └────────────────────────────────────────────────────────────────────────┘
  许可证状态直接写在引擎卡上（避免误用——落地指南 §2.1 最大风险）。
-->
<UserControl x:Class="AIris.WPF.Views.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" xmlns:converters="clr-namespace:AIris.WPF.Converters"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🧠 检测引擎" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                <Border Style="{DynamicResource KxChip}" Background="{DynamicResource ThemePanel2Bg}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineState}" Style="{DynamicResource KxChipText}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回监控台" Command="{Binding BackCommand}" Style="{DynamicResource FreshButton}"
                        FontSize="12" Padding="14,7" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="应用配置" Command="{Binding ApplyCommand}" Style="{DynamicResource FreshPrimaryButton}"
                        FontSize="12" Padding="16,7" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 引擎卡流 -->
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="460" Margin="0,0,14,14" CornerRadius="16" Padding="16"
                                    Background="{DynamicResource ThemePanelBg}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                        <Style.Triggers>
                                            <!-- 回落执行中（选中引擎未接入，实际由 Mock 兜底）：警示色，且不抢"当前引擎"描边 -->
                                            <DataTrigger Binding="{Binding Fallback}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeWarn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                                        <Border HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource KxChip}">
                                                    <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fallback}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeWarnDim}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KxChipText}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Fallback}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeWarn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <!-- 许可证胶囊（引擎页核心信息；KxChip Tag=Warn 语义档） -->
                                    <Border Style="{DynamicResource KxChip}" Tag="Warn" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LicenseNote}" FontSize="10.5" Style="{DynamicResource KxChipText}" Tag="Warn"/>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run>开放词汇即指即检 · 归一化坐标框输出 · 判定走 ROI-IoU 几何规则</Run>
                                    </TextBlock>
                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="切换需重载引擎（未接入时回落 Mock 演示）" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                        <Button Content="{Binding SwitchText}" Command="{Binding SwitchCommand}" IsEnabled="{Binding SwitchEnabled}"
                                                Style="{DynamicResource FreshPrimaryButton}" FontSize="12" Padding="14,6"
                                                Cursor="Hand" HorizontalAlignment="Right"
                                                Visibility="{Binding Active, Converter={StaticResource InvBoolToVis}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 推理参数卡（V0.1.7：协议下拉 + API Key + 测试连接——沉库 Kaleidoscope.Infer 后可切部署形态） -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,4,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="推理参数" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <TextBlock Text="改动需点右上「应用配置」" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="推理协议（选对部署形态的信封）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <ComboBox ItemsSource="{Binding ProtocolChoices}" SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"
                                          DisplayMemberPath="Content" Style="{DynamicResource FreshCombo}" FontSize="12" Padding="10,7" Margin="0,4"
                                          ToolTip="自研契约=locateanything-batch 服务；OpenAI 兼容=vLLM/llama.cpp/LMDeploy；Ollama=本地 Ollama；Anthropic=云端 Claude"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="API Key（本地服务留空）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"
                                         ToolTip="OpenAI 兼容=Authorization Bearer；Anthropic=x-api-key"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="解码模式（LocateAnything PBD 三档 · 属自研契约服务端）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <ComboBox ItemsSource="{Binding DecodeModeChoices}" SelectedItem="{Binding DecodeMode}" IsEnabled="{Binding IsCustomProtocol}" Style="{DynamicResource FreshCombo}" FontSize="12" Padding="10,7" Margin="0,4"
                                          ToolTip="仅自研 FastAPI 契约（locateanything-batch）使用；其他协议该参数由服务端决定"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="批处理大小（属自研契约服务端）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}" IsEnabled="{Binding IsCustomProtocol}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="HTTP 推理服务地址（接入真实引擎后生效）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding HttpBaseUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"
                                         ToolTip="如 http://127.0.0.1:8000（vLLM） / http://127.0.0.1:8080（llama-server） / http://127.0.0.1:11434（Ollama）"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="服务模型名" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding HttpModel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"
                                         ToolTip="如 locateanything-3b / Qwen/Qwen2.5-VL-7B-Instruct / llava / claude-sonnet-4-5"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Style="{DynamicResource FreshButton}"
                                    FontSize="11.5" Padding="14,6" Cursor="Hand" ToolTip="用表单当前值探活（不保存）"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 服务状态卡（只读） -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="服务状态" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <TextBlock Text="只读 · 随运行自动刷新" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="显存占用" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding MemoryNote, FallbackValue=—}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="单帧耗时" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}">
                                        <Run Text="{Binding LastMs, Mode=OneWay}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="累计调用" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding TotalCalls, FallbackValue=0}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeOk}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="当前引擎" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Text="{Binding ActiveEngineName, FallbackValue=—}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
