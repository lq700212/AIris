<!--
  检测引擎页（设计稿 data-page="engine" · C 方案）

  ┌ 页头：🧠 检测引擎 · Qwen3-VL-8B 已加载   [← 返回监控台] [＋ 添加引擎] [应用配置] ┐
  ├──────────────────────────────────────────────────────────────────────┤
  │ [Mock 数据模式提示条]（仅 MockMode=True 时显示）                          │
  │ 引擎牌堆（扑克牌形态，永不换行）：收拢 = 一叠牌（当前引擎在最上面）         │
  │  · 点击牌堆 → 扇形展开（弧形排列 + 轻微旋转 + 依次飞出动画）              │
  │  · 点某张牌 = 切换引擎并收拢；点空白 = 收拢；悬停牌面放大 1.05            │
  │  · 许可证直接标在牌面（研究许可红胶囊，Apache 绿胶囊）                     │
  │  · 每卡独立连接参数（协议/地址/模型名），切换即回填推理参数表单             │
  │  · 「＋ 添加引擎」追加自定义牌（可删除），接新模型零改代码                  │
  ├──────────────────────────────────────────────────────────────────────┤
  │ 推理参数卡（2 列）：协议 / API Key → 地址 / 模型名 → 解码 / 批大小         │
  │  · 底部右对齐：就地探活胶囊（绿=在线+ms / 红=不可达原因）+ [测试连接]      │
  ├──────────────────────────────────────────────────────────────────────┤
  │ 服务状态卡（4 KPI）：显存 / 单帧耗时 / 累计调用 / 当前引擎                  │
  └──────────────────────────────────────────────────────────────────────┘
  vNext 落地（2026-11-23）：引擎卡扩展 = Qwen3-VL-8B 内置卡 + 自定义引擎卡（添加/删除/独立参数）。
  2026-11-28：新增 Qwen2.5-VL-3B（Ollama 本地）内置卡——低配开发机先验链路（落地指南 §2.9.5）。
  2026-11-28 收口：Mock 不再是引擎卡（也不是相机类型），统一由顶栏「Mock 数据」全局开关控制；
  本页只列真实模型卡，MockMode 期间顶部提示条明示"真实卡暂不生效"。
  2026-11-28 牌堆改版：用户要求"换行就做成扑克牌收拢 → 展开"（图三红框行距过近 + 观感炫酷）；
  卡片从 UniformGrid 四列改 Canvas 绝对定位 + RenderTransform 动画，详见 EngineDeckController.cs。
-->
<UserControl x:Class="AIris.WPF.Views.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:AIris.WPF.Assets">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <!-- 页头图标字符与顶栏导航胶囊同源（🧠），2026-11-23 用户要求：各页页头统一带 Icon -->
                <TextBlock Text="🧠 检测引擎" Style="{StaticResource AiPageTitle}"/>
                <TextBlock Text="{Binding EngineState, FallbackValue=—}" Style="{StaticResource AiPageSub}"
                           TextTrimming="CharacterEllipsis" MaxWidth="620"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回监控台" Command="{Binding BackCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"/>
                <Button Content="＋ 添加引擎" Command="{Binding AddEngineCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"
                        ToolTip="接入新的视觉模型（自定义引擎卡，落 Data\EngineCards.json）"/>
                <Button Content="应用配置" Command="{Binding ApplyCommand}"
                        Style="{StaticResource AiBtnPrimary}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- ===== Mock 数据模式提示条（仅 MockMode=True） =====
                     说清三件事：当前是演示数据、真实卡暂不生效、点卡即退出 Mock。 -->
                <Border Background="{DynamicResource ThemeWarnDim}" CornerRadius="10"
                        Padding="14,9" Margin="0,0,0,12"
                        Visibility="{Binding IsMockMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mock 数据模式" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeWarn}" VerticalAlignment="Center"/>
                        <TextBlock Text="相机与引擎均为演示数据；下方真实引擎卡暂不生效。点任意卡「切换到此引擎」会关闭 Mock 并切回真实设备。"
                                   FontSize="11" Foreground="{DynamicResource ThemeWarn}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== 引擎牌堆（2026-11-28 用户定版：引擎卡统一做成扑克牌，永不换行） =====

                     定版口径（用户 2026-11-28 明确）：
                       「不管换不换行，统一做成炫酷的扑克牌样式」——不再区分张数多少，
                       引擎卡从 2 张到 20 张全部走牌堆形态，绝不出现第二排。

                     设计口径：
                       · 收拢态 = 一叠牌，最上面是当前引擎（完整牌面），其余牌向下错开
                         2.6px 依次露边形成厚度感；右下角提示"共 N 个引擎 · 点击展开"。
                       · 展开态 = 所有牌一行扇形铺开，中间高两边低 + 轻微旋转，
                         当前引擎主色描边高亮；点任意牌 = 切换引擎并收拢，点空白 = 收拢。
                       · 牌宽按容器宽度 / 张数动态计算（232px 起，最窄 132px）；
                         张数多到 132px 也放不下时自动改为**重叠排列**（像手里捏一把牌），
                         依然一行、依然可点，永不换行。
                       · 动效：展开 360ms CubicEase + 每张 38ms 依次飞出；收拢 280ms 倒序飞回；
                         悬停牌面放大 1.045（布局动画只碰 Translate/Rotate，悬停只碰 Scale）。

                     实现：ItemsControl + Canvas 面板，所有牌先叠在同一个基准位，位移/旋转全靠
                     RenderTransform（Translate/Rotate）做动画——不触发重新布局，60fps 流畅。
                     控制器见 Views/EngineDeckController.cs。 -->
                <Grid x:Name="DeckHost" Height="200" Margin="0,0,0,0" Background="Transparent"
                      MouseLeftButtonDown="DeckHost_MouseLeftButtonDown">
                    <!-- 牌堆厚度：两层"纸边"（收拢态可见，展开时淡出；宽度由控制器跟随牌宽）。
                         Z 序在牌面之下，只在收拢态露边，不做命中测试。
                         底色用 Panel2（比牌面深一档）才能看出"一叠纸"的层次。 -->
                    <Border x:Name="DeckBack2" Style="{StaticResource AiCard}" Opacity="0"
                            Background="{DynamicResource ThemePanel2Bg}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,26,0,0" Height="158" IsHitTestVisible="False"/>
                    <Border x:Name="DeckBack1" Style="{StaticResource AiCard}" Opacity="0"
                            Background="{DynamicResource ThemePanel2Bg}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,20,0,0" Height="158" IsHitTestVisible="False"/>

                    <!-- 牌面集合（所有牌先叠在同一个基准位，位移/旋转由 EngineDeckController 用
                         RenderTransform 动画推开——不触发重新布局，永不换行） -->
                    <ItemsControl x:Name="Deck" ItemsSource="{Binding Cards}"
                                  Focusable="False" FocusVisualStyle="{x:Null}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas ClipToBounds="False"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <!-- 宽度由控制器按"容器宽度 / 牌数"动态写入（永不换行的关键）；
                                     RenderTransform 也由控制器代码创建——写在 Style Setter 里会被
                                     WPF 冻结成共享实例，动画一改就抛"无法修改冻结对象" -->
                                <Setter Property="Height" Value="158"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 牌面：外层透明 Grid = 固定命中区（不参与上浮动画），
                                     内部两层 = 影子层（索引 0，纯色模糊）+ 牌面层（索引 1，上浮）。
                                     为什么拆命中区：上浮 6px 会让卡片下边缘离开鼠标，
                                     命中区跟着动就会 MouseLeave→回弹→MouseEnter 无限抖动。
                                     为什么投影不挂在牌面上：Effect 会把整个元素（含文字）
                                     先渲染成位图，ClearType 失效 → 悬停时文字明显发虚；
                                     影子层是纯黑 Border，模糊只作用在它身上，牌面文字始终清晰。 -->
                                <Grid Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                      MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                                    <!-- 影子层（模板结构约定：Children[0]）：与牌面同尺寸、固定下移 5px，
                                         悬停时由控制器淡入并动态挂 BlurEffect，离开淡出后摘掉。
                                         颜色绑主题键：浅色淡黑 / 暗色浓黑（暗色底上淡黑完全看不见） -->
                                    <Border x:Name="CardShadow" Background="{DynamicResource ThemeCardShadow}"
                                            CornerRadius="16" Opacity="0" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="5"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <!-- 牌面层（模板结构约定：Children[1]）：不写 Background
                                         （本地值会覆盖 AiCard 的 ThemePanelBg，卡片会变透明玻璃）；
                                         命中靠外层 Grid 的 Transparent -->
                                    <Border x:Name="CardVisual" Padding="14,12,14,12">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AiCard}">
                                                <Style.Triggers>
                                                    <!-- 当前引擎：主色描边焦点卡（Mock 数据模式下不高亮任何真实卡） -->
                                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                                        <Setter Property="BorderThickness" Value="1.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 标题 + 当前引擎指示（圆点比胶囊省 50px 宽，长模型名不再被截断）
                                             平台括号用小一号灰字：workbuddy 这类平台名很长，
                                             同字号会把模型主名挤成省略号 -->
                                        <Grid Grid.Row="0">
                                            <TextBlock FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeTextFg}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding VendorSuffix, Mode=OneWay}"
                                                     FontSize="11" FontWeight="Normal"
                                                     Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </TextBlock>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource ThemeOk}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Visibility="{Binding Active, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>

                                        <!-- 许可证胶囊 + Magpie 品牌标（反代卡才显示：喜鹊图标 + 网关名，
                                             与许可证同排左右平衡，不占标题宽度） -->
                                        <Grid Grid.Row="1" Margin="0,9,0,0">
                                            <ContentControl Content="{Binding LicenseNote}"
                                                            HorizontalAlignment="Left">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipPlainWarn}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LicenseTag}" Value="Ng">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LicenseTag}" Value="Ok">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Visibility="{Binding IsMagpie, Converter={StaticResource BoolToVis}}">
                                                <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                                    <Path Data="{x:Static assets:MagpieLogo.Geometry}"
                                                          Fill="{DynamicResource ThemePrimary}"/>
                                                </Viewbox>
                                                <TextBlock Text="Magpie" FontSize="10"
                                                           Foreground="{DynamicResource ThemeTextMuted}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 服务参数（协议 · 模型名）：切卡前一眼看清连的是哪套服务 -->
                                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ServiceLine}" FontSize="10.5"
                                                       Foreground="{DynamicResource ThemeTextMuted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="开放词汇即指即检 · ROI-IoU 几何判定" FontSize="10"
                                                       Foreground="{DynamicResource ThemeTextMuted}"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- 底部：删除（仅自定义卡） -->
                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding DeckHintText}" FontSize="10"
                                                       Foreground="{DynamicResource ThemeTextMuted}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                            <Button Content="🗑" Command="{Binding DeleteCommand}"
                                                    Style="{StaticResource AiBtnDangerGhostSm}"
                                                    HorizontalAlignment="Right"
                                                    Width="30" Padding="0"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 牌堆状态提示（右下角）：收拢=共 N 个引擎·点击展开 / 展开=点卡片切换·点空白收起 -->
                    <ContentControl x:Name="DeckHintChip" Style="{StaticResource AiChipPlainPri}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,2,2" IsHitTestVisible="False">
                        <TextBlock x:Name="DeckHintText" FontSize="10.5"/>
                    </ContentControl>
                </Grid>

                <!-- ===== 推理参数（设计稿顺序：协议/Key → 地址/模型 → 解码/批大小） ===== -->
                <Border Style="{StaticResource AiCard}" Padding="18,14,18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="推理参数" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="改动需点右上「应用配置」" Style="{StaticResource AiCardSub}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="推理协议（选对部署形态的信封）" Style="{StaticResource AiFormLabel}"/>
                                <ComboBox ItemsSource="{Binding ProtocolChoices}"
                                          SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"
                                          DisplayMemberPath="Content" Style="{StaticResource AiCombo}"
                                          ToolTip="自研契约=locateanything-batch；OpenAI 兼容=vLLM/llama.cpp/LMDeploy；Ollama=本地；Anthropic=云端"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="API Key（本地服务留空）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="OpenAI 兼容=Authorization Bearer；Anthropic=x-api-key"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="HTTP 推理服务地址（接入真实引擎后生效）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding HttpBaseUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="填 http://127.0.0.1:8000（vLLM）/ http://127.0.0.1:8080（llama-server）/ http://127.0.0.1:11434（Ollama）"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="服务模型名" Style="{StaticResource AiFormLabel}" VerticalAlignment="Center"/>
                                    <!-- Magpie 模型快捷选择：拉 /v1/models 列表，点胶囊直接填模型名（2026-11-28） -->
                                    <Button Command="{Binding FetchMagpieModelsCommand}"
                                            Style="{StaticResource AiBtnGhostSm}" HorizontalAlignment="Right"
                                            Padding="8,2" FontSize="10.5" Height="21" MinWidth="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                                <Path Data="{x:Static assets:MagpieLogo.Geometry}"
                                                      Fill="{DynamicResource ThemeTextMuted}"/>
                                            </Viewbox>
                                            <TextBlock Text="Magpie 模型" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox Text="{Binding HttpModel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="填 locateanything-3b / Qwen/Qwen3-VL-8B-Instruct / Qwen/Qwen3-VL-4B-Instruct / llava"/>
                                <!-- 拉取结果提示（成功=数量 / 失败=原因） -->
                                <TextBlock Text="{Binding MagpieHint}" FontSize="10.5"
                                           Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           Visibility="{Binding HasMagpieHint, Converter={StaticResource BoolToVis}}"/>
                                <!-- 模型胶囊列表：点一个即填入模型名（含 owner，区分同名模型的不同提供方） -->
                                <ItemsControl ItemsSource="{Binding MagpieModels}" Margin="0,7,0,0"
                                              Visibility="{Binding HasMagpieModels, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ChipLabel}"
                                                    Style="{StaticResource AiBtnGhostSm}"
                                                    Margin="0,0,6,6" Padding="9,2" FontSize="10.5"
                                                    Command="{Binding DataContext.PickMagpieModelCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="解码模式（LocateAnything PBD 三档 · 仅自研服务端）" Style="{StaticResource AiFormLabel}"/>
                                <ComboBox ItemsSource="{Binding DecodeModeChoices}" SelectedItem="{Binding DecodeMode}"
                                          IsEnabled="{Binding IsCustomProtocol}" Style="{StaticResource AiCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="批处理大小（自研服务端）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}"
                                         IsEnabled="{Binding IsCustomProtocol}" Style="{StaticResource AiInput}"
                                         ToolTip="仅自研 FastAPI 契约（locateanything-batch）使用；其他协议该参数由服务端决定"/>
                            </StackPanel>
                        </Grid>

                        <!-- vNext：测试连接就地反馈（结果胶囊在按钮左侧，在线/不可达一眼可见） -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <ContentControl MinHeight="24" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipMut}">
                                        <Setter Property="Content" Value="{Binding TestText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestState}" Value="ok">
                                                <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TestState}" Value="fail">
                                                <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource AiBtnSecondarySm}" VerticalAlignment="Center"
                                    ToolTip="用表单当前值探活（不保存），结果显示在左侧胶囊"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 服务状态（只读 4 KPI） ===== -->
                <Border Style="{StaticResource AiCard}" Padding="18,14,18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="服务状态" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="只读 · 随运行自动刷新" Style="{StaticResource AiCardSub}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="显存占用" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding MemoryNote, FallbackValue=—}" Style="{StaticResource AiKpiValueSm}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="单帧耗时" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Style="{StaticResource AiKpiValue}">
                                        <Run Text="{Binding LastMs, Mode=OneWay}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="累计调用" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding TotalCalls, FallbackValue=0}" Style="{StaticResource AiKpiValue}"
                                               Foreground="{DynamicResource ThemePrimary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}">
                                <StackPanel>
                                    <TextBlock Text="当前引擎" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding ActiveEngineName, FallbackValue=—}" Style="{StaticResource AiKpiValueSm}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 页面底部说明（设计稿：卡参数与自定义卡落盘位置） -->
                <Border Style="{StaticResource AiCard}" Padding="18,12,18,12" Margin="0,14,0,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"
                               Text="每张引擎卡独立保存连接参数（协议 / 地址 / 模型名），切换即回填推理参数表单 · 自定义引擎卡落 00_ExeBuild\Data\EngineCards.json（现场数据，不入库）· 内置卡不可删除，自定义卡可删除"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>