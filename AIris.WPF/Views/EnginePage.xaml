<!--
  检测引擎页（设计稿 data-page="engine" · C 方案）

  ┌ 页头：🧠 检测引擎 · Qwen3-VL-8B 已加载   [← 返回监控台] [＋ 添加引擎] [应用配置] ┐
  ├──────────────────────────────────────────────────────────────────────┤
  │ 四引擎卡（4 列等分）：Mock / LocateAnything-3B / Qwen2.5-VL-7B / Qwen3-VL-8B │
  │  · 许可证直接标在卡上（研究许可红胶囊，Apache 绿胶囊）                      │
  │  · 每卡独立连接参数（协议/地址/模型名），切换即回填推理参数表单             │
  │  · 「＋ 添加引擎」追加自定义卡（可删除），接新模型零改代码                  │
  ├──────────────────────────────────────────────────────────────────────┤
  │ 推理参数卡（2 列）：协议 / API Key → 地址 / 模型名 → 解码 / 批大小         │
  │  · 底部右对齐：就地探活胶囊（绿=在线+ms / 红=不可达原因）+ [测试连接]      │
  ├──────────────────────────────────────────────────────────────────────┤
  │ 服务状态卡（4 KPI）：显存 / 单帧耗时 / 累计调用 / 当前引擎                  │
  └──────────────────────────────────────────────────────────────────────┘
  vNext 落地（2026-11-23）：引擎卡扩展 = Qwen3-VL-8B 内置卡 + 自定义引擎卡（添加/删除/独立参数）。
-->
<UserControl x:Class="AIris.WPF.Views.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AIris.WPF.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <!-- 页头图标字符与顶栏导航胶囊同源（🧠），2026-11-23 用户要求：各页页头统一带 Icon -->
                <TextBlock Text="🧠 检测引擎" Style="{StaticResource AiPageTitle}"/>
                <TextBlock Text="{Binding EngineState, FallbackValue=—}" Style="{StaticResource AiPageSub}"
                           TextTrimming="CharacterEllipsis" MaxWidth="620"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回监控台" Command="{Binding BackCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"/>
                <Button Content="＋ 添加引擎" Command="{Binding AddEngineCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"
                        ToolTip="接入新的视觉模型（自定义引擎卡，落 Data\EngineCards.json）"/>
                <Button Content="应用配置" Command="{Binding ApplyCommand}"
                        Style="{StaticResource AiBtnPrimary}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- ===== 引擎卡（4 列等分；自定义卡追加在末尾） ===== -->
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,14,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,15,16,15">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AiCard}">
                                        <Style.Triggers>
                                            <!-- 回落执行中：警示描边（选中引擎未接入，实际由 Mock 兜底） -->
                                            <DataTrigger Binding="{Binding Fallback}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeWarn}"/>
                                            </DataTrigger>
                                            <!-- 当前引擎：主色描边焦点卡 -->
                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource ThemeTextFg}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <!-- 状态胶囊：当前引擎=绿 / 回落执行中=黄 / 可切换=灰 -->
                                        <ContentControl HorizontalAlignment="Right" Content="{Binding StateText}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipMut}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fallback}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeWarnDim}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeWarn}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>

                                    <!-- 许可证胶囊（直接标在卡上，避免误用：落地指南 §2.1 最大风险） -->
                                    <ContentControl Content="{Binding LicenseNote}" Margin="0,10,0,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipPlainWarn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LicenseTag}" Value="Ng">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseTag}" Value="Ok">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <TextBlock Text="开放词汇即指即检 · 归一化坐标框输出 · 判定走 ROI-IoU 几何规则"
                                               FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                                               Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock Text="切换需重载引擎（未接入时回落 Mock 演示）"
                                               FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                                               Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                    <!-- 服务参数小字（协议 · 模型名）：切卡前一眼看清连的是哪套服务 -->
                                    <TextBlock Text="{Binding ServiceLine}" FontSize="10.5"
                                               Foreground="{DynamicResource ThemeTextMuted}"
                                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ServiceLine}"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <!-- 删除：仅自定义卡显示（内置卡 CanDelete=false 隐藏） -->
                                        <Button Content="🗑" Command="{Binding DeleteCommand}"
                                                Style="{StaticResource AiBtnDangerGhostSm}"
                                                Width="34" Padding="0" Margin="0,0,8,0"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                ToolTip="删除自定义引擎卡（内置卡不可删除）"/>
                                        <Button Content="{Binding SwitchText}" Command="{Binding SwitchCommand}"
                                                IsEnabled="{Binding SwitchEnabled}"
                                                Style="{StaticResource AiBtnPrimarySm}"
                                                Visibility="{Binding Active, Converter={StaticResource InvBoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== 推理参数（设计稿顺序：协议/Key → 地址/模型 → 解码/批大小） ===== -->
                <Border Style="{StaticResource AiCard}" Padding="18,14,18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="推理参数" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="改动需点右上「应用配置」" Style="{StaticResource AiCardSub}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="推理协议（选对部署形态的信封）" Style="{StaticResource AiFormLabel}"/>
                                <ComboBox ItemsSource="{Binding ProtocolChoices}"
                                          SelectedValue="{Binding Protocol}" SelectedValuePath="Tag"
                                          DisplayMemberPath="Content" Style="{StaticResource AiCombo}"
                                          ToolTip="自研契约=locateanything-batch；OpenAI 兼容=vLLM/llama.cpp/LMDeploy；Ollama=本地；Anthropic=云端"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="API Key（本地服务留空）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}" ToolTip="OpenAI 兼容=Authorization Bearer；Anthropic=x-api-key"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="HTTP 推理服务地址（接入真实引擎后生效）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding HttpBaseUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="如 http://127.0.0.1:8000（vLLM） / http://127.0.0.1:8080（llama-server） / http://127.0.0.1:11434（Ollama）"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="服务模型名" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding HttpModel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="如 locateanything-3b / Qwen/Qwen3-VL-8B-Instruct / Qwen/Qwen3-VL-4B-Instruct / llava"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="解码模式（LocateAnything PBD 三档 · 仅自研服务端）" Style="{StaticResource AiFormLabel}"/>
                                <ComboBox ItemsSource="{Binding DecodeModeChoices}" SelectedItem="{Binding DecodeMode}"
                                          IsEnabled="{Binding IsCustomProtocol}" Style="{StaticResource AiCombo}"
                                          ToolTip="仅自研 FastAPI 契约（locateanything-batch）使用；其他协议该参数由服务端决定"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="批处理大小（自研服务端）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}"
                                         IsEnabled="{Binding IsCustomProtocol}" Style="{StaticResource AiInput}"/>
                            </StackPanel>
                        </Grid>

                        <!-- vNext：测试连接就地反馈（结果胶囊在按钮左侧，在线/不可达一眼可见） -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <ContentControl MinHeight="24" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl" BasedOn="{StaticResource AiChipMut}">
                                        <Setter Property="Content" Value="{Binding TestText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestState}" Value="ok">
                                                <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TestState}" Value="fail">
                                                <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource AiBtnSecondarySm}" VerticalAlignment="Center"
                                    ToolTip="用表单当前值探活（不保存），结果显示在左侧胶囊"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 服务状态（只读 4 KPI） ===== -->
                <Border Style="{StaticResource AiCard}" Padding="18,14,18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="服务状态" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="只读 · 随运行自动刷新" Style="{StaticResource AiCardSub}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="显存占用" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding MemoryNote, FallbackValue=—}" Style="{StaticResource AiKpiValueSm}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="单帧耗时" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Style="{StaticResource AiKpiValue}">
                                        <Run Text="{Binding LastMs, Mode=OneWay}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="累计调用" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding TotalCalls, FallbackValue=0}" Style="{StaticResource AiKpiValue}"
                                               Foreground="{DynamicResource ThemePrimary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AiKpi}">
                                <StackPanel>
                                    <TextBlock Text="当前引擎" Style="{StaticResource AiKpiLabel}"/>
                                    <TextBlock Text="{Binding ActiveEngineName, FallbackValue=—}" Style="{StaticResource AiKpiValueSm}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 页面底部说明（设计稿：卡参数与自定义卡落盘位置） -->
                <Border Style="{StaticResource AiCard}" Padding="18,12,18,12" Margin="0,14,0,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap"
                               Text="每张引擎卡独立保存连接参数（协议 / 地址 / 模型名），切换即回填推理参数表单 · 自定义引擎卡落 00_ExeBuild\Data\EngineCards.json（现场数据，不入库）· 内置卡不可删除，自定义卡可删除"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
