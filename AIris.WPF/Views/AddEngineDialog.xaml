<!--
  添加检测引擎弹窗（设计稿弹窗 m-add-engine：自定义模型接入）。

  ┌ 标题条：＋ 添加检测引擎 · 接入新的视觉模型                        ✕ ┐
  ├──────────────────────────────────────────────────────────────────┤
  │ 引擎名称*            │ 许可证说明                                  │
  │ 推理协议（四协议）   │ API Key（本地留空）                         │
  │ HTTP 推理服务地址    │ 服务模型名                                  │
  │ 提示：保存后追加引擎卡，落 Data\EngineCards.json                   │
  ├──────────────────────────────────────────────────────────────────┤
  │                                          [取消]  [添加引擎]        │
  └──────────────────────────────────────────────────────────────────┘

  2026-11-23 引擎卡扩展：添加后即可在引擎页「测试连接」→「切换到此引擎」，
  接新模型零改代码（落盘 = EngineCardStore，见落地指南 §2.8）。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.AddEngineDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="添加检测引擎" Width="640" SizeToContent="Height" UseLayoutRounding="True" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource ThemePanelBg}" Padding="18,14,18,16">
        <StackPanel>
            <TextBlock Text="填写模型的推理服务信息；保存后追加为引擎卡，和内置卡一样可测试连接、切换。"
                       FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="引擎名称（卡片标题，必填）" Style="{StaticResource AiFormLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource AiInput}"
                             ToolTip="如：Qwen3-VL-4B / 自研产线检测模型 V2"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="许可证说明（直接标在卡片上）" Style="{StaticResource AiFormLabel}"/>
                    <TextBox x:Name="LicenseBox" Style="{StaticResource AiInput}"
                             Text="许可证：Apache 2.0 · 自定义接入"
                             ToolTip="商用前必须确认模型许可证；研究许可请如实标注"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="推理协议（选对部署形态的信封）" Style="{StaticResource AiFormLabel}"/>
                    <ComboBox x:Name="ProtocolCombo" Style="{StaticResource AiCombo}"
                              SelectedValuePath="Tag" SelectedIndex="0"
                              ToolTip="OpenAI 兼容=vLLM/llama.cpp/LMDeploy；自研契约=/detect 框直出；Ollama=本地；Anthropic=云端">
                        <ComboBoxItem Content="OpenAI 兼容（vLLM / llama-server · 推荐）" Tag="openai"/>
                        <ComboBoxItem Content="自研 FastAPI 契约（/detect · 框直出）" Tag="custom"/>
                        <ComboBoxItem Content="Ollama 原生（/api/chat）" Tag="ollama"/>
                        <ComboBoxItem Content="Anthropic（云端，不适用离线）" Tag="anthropic"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="API Key（本地服务留空）" Style="{StaticResource AiFormLabel}"/>
                    <TextBox x:Name="KeyBox" Style="{StaticResource AiInput}"
                             ToolTip="OpenAI 兼容=Authorization Bearer；Anthropic=x-api-key"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="HTTP 推理服务地址" Style="{StaticResource AiFormLabel}"/>
                    <TextBox x:Name="UrlBox" Style="{StaticResource AiInput}" Text="http://127.0.0.1:8000"
                             ToolTip="不带端点路径：vLLM 8000 / llama-server 8080 / Ollama 11434"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="服务模型名" Style="{StaticResource AiFormLabel}"/>
                    <TextBox x:Name="ModelBox" Style="{StaticResource AiInput}"
                             ToolTip="vLLM 的 --served-model-name / Ollama 模型 tag / 自研服务路由名"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="保存后可在引擎页先「测试连接」验证，再点卡片「切换到此引擎」；记录存 Data\EngineCards.json（现场数据，不入库）。"
                       FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"
                       TextWrapping="Wrap" Margin="0,14,0,0"/>

            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="添加引擎" Style="{StaticResource AiBtnPrimary}" Click="Add_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
