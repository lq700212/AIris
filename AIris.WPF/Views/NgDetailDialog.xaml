<!--
  NG 详情弹窗（设计稿 dlg-ng）：判定原因 + 规则快照 + 存档指引，按钮"关闭/重检本步"。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.NgDetailDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="NG 详情" Width="640" SizeToContent="Height" UseLayoutRounding="True" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource ThemePanelBg}" Padding="18,14,18,16">
        <StackPanel>
            <!-- 标题条已有「NG 详情」：内容区只留工步徽标，避免重复标题（2026-11-23 统一口径） -->
            <TextBlock x:Name="StepBadge" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="170" CornerRadius="10" Background="{DynamicResource ThemePanel2Bg}" ClipToBounds="True">
                    <Image x:Name="ShotImage" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="2" TextElement.FontSize="12">
                    <TextBlock x:Name="ReasonText" Foreground="{DynamicResource ThemeNg}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RuleText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BeaconText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ShotText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="建议：补装后点「重检本步」，历史 NG 保留在同一追溯链" FontSize="11"
                       Foreground="{DynamicResource ThemeWarn}" Margin="0,12,0,0"/>
            <!-- 设计稿 .mf：右对齐 + 上方 1px 分隔线 + 12px 上内距 -->
            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0" Click="Close_Click"/>
                    <Button Content="重检本步" Style="{StaticResource AiBtnPrimary}" Click="Recheck_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
