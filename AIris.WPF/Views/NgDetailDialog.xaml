<!--
  NG 详情弹窗（设计稿 dlg-ng）：判定原因 + 规则快照 + 存档指引，按钮"关闭/重检本步"。
-->
<ui:ChromeDialogWindow x:Class="AIris.WPF.Views.NgDetailDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                       Title="NG 详情" Width="640" SizeToContent="Height" Resizeable="False" ShowMinButton="False" ShowMaxButton="False">
    <Border Background="{DynamicResource Brush.Fresh.CardBg}" Padding="18,14,18,16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="NG 详情" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeNg}"/>
                <TextBlock x:Name="StepBadge" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,1,0,0"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="170" CornerRadius="10" Background="{DynamicResource ThemePanel2Bg}" ClipToBounds="True">
                    <Image x:Name="ShotImage" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="2" TextElement.FontSize="12">
                    <TextBlock x:Name="ReasonText" Foreground="{DynamicResource ThemeNg}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RuleText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BeaconText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ShotText" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="建议：补装后点「重检本步」，历史 NG 保留在同一追溯链" FontSize="11"
                       Foreground="{DynamicResource ThemeWarn}" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="关闭" Style="{DynamicResource FreshButton}" FontSize="12.5" Padding="16,7" Margin="0,0,10,0" Cursor="Hand" Click="Close_Click"/>
                <Button Content="重检本步" Style="{DynamicResource FreshPrimaryButton}" FontSize="12.5" Padding="16,7" Cursor="Hand" Click="Recheck_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</ui:ChromeDialogWindow>
