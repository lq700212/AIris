<!--
  配方中心（设计稿 data-page="recipe" · C 方案）

  ┌ 页头：▤ 配方中心 · 启用 1/共N            [新建配方(primary)] ┐
  │ 配方卡流（WrapPanel，每卡：名称+状态胶囊/类目行/元行/操作钮）  │
  │ 启用中的卡 = 主色描边焦点卡；空态 = 引导新建                  │
  └──────────────────────────────────────────────────────────────┘
-->
<UserControl x:Class="AIris.WPF.Views.RecipeListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" xmlns:converters="clr-namespace:AIris.WPF.Converters"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▤ 配方中心" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}" VerticalAlignment="Center"/>
                <Border Style="{DynamicResource KxChip}" Background="{DynamicResource ThemePanel2Bg}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EnabledNote}" Style="{DynamicResource KxChipText}"/>
                </Border>
            </StackPanel>
            <Button Content="＋ 新建配方" Command="{Binding NewRecipeCommand}" Style="{DynamicResource FreshPrimaryButton}"
                    FontSize="13" Padding="18,8" Cursor="Hand" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 配方卡流 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="430"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" CornerRadius="16" Padding="16"
                                Background="{DynamicResource ThemePanelBg}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- 卡头：名称 + 状态胶囊 -->
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                                    <Border HorizontalAlignment="Right" Style="{DynamicResource KxChip}" Tag="Ok" Padding="9,3" Background="{DynamicResource ThemeOkDim}"
                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="启用中" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeOk}"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" Style="{DynamicResource KxChip}" Padding="9,3" Background="{DynamicResource ThemePanel2Bg}"
                                            Visibility="{Binding Enabled, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="已停用" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    </Border>
                                </Grid>

                                <!-- 类目行（自然语言描述 = 配方核心资产） -->
                                <TextBlock Text="{Binding PartsLine}" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <!-- 元行 -->
                                <TextBlock Text="{Binding MetaLine}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>

                                <!-- 卡脚操作 -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="编辑" Command="{Binding EditCommand}" Style="{DynamicResource FreshPrimaryButton}"
                                            FontSize="12" Padding="14,6" Cursor="Hand"/>
                                    <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{DynamicResource FreshButton}"
                                            FontSize="12" Padding="14,6" Margin="8,0,0,0" Cursor="Hand"/>
                                    <Button Content="🗑" Command="{Binding DeleteCommand}" Style="{DynamicResource FreshDangerButton}"
                                            FontSize="12" Padding="10,6" Margin="8,0,0,0" Cursor="Hand" ToolTip="删除配方（二次确认）"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空态 -->
        <Border Grid.Row="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="16" Padding="40"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▤" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}"/>
                <TextBlock Text="还没有配方" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="用一句话描述产品零件，AI 预填工步草稿" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Button Content="新建第一个配方" Command="{Binding NewRecipeCommand}" Style="{DynamicResource FreshPrimaryButton}"
                        FontSize="13" Padding="18,8" Cursor="Hand" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
