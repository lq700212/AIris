<!--
  配方编辑器（设计稿 data-page="editor" · C 方案）

  ┌ 页头：◈ 配方编辑器 · 配方名      [← 返回配方中心] [保存配方]          ┐
  ├──────────────┬──────────────────────────────────────────────────────┐
  │ 工步序列卡    │ 工步配置卡：工步名 / 预期零件 / 预期变化 / 判定区域     │
  │ 236 固定      │ 判定规则卡：IoU / 稳定帧 / 数量 / 安全件双通道          │
  │ (选中高亮)    │ ROI 标画卡：[画布 1fr | 右栏 300]                       │
  │ [+ 添加工步]  │   右栏 = 选中ROI数值(2×2) + 判定区域清单 + 删除         │
  │ 编制顺序卡    │                                                     │
  └──────────────┴──────────────────────────────────────────────────────┘

  结构口径（对齐设计稿 · 2026-11-23 整改）：
  · 左列固定 236（旧 250），ROI 清单原在左列第二卡 → 移入画布右侧 300px 栏，
    数值输入不再压卡片底边（设计稿 .kpi 独立小卡 + 2×2 网格）；
  · 画布视口高 440（设计稿 .stage height:440px），舞台按帧 4:3 内接居中；
  · 选中行高亮绑 VM.IsSelected（旧写法绑不存在的 ContentPresenter.IsSelected 恒不触发）。
  交互红线：RoiStage/RoiViewport 两个 x:Name 被 RoiStageController 使用，改名即拖拽失效。
-->
<UserControl x:Class="AIris.WPF.Views.RecipeEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ROI 画布"全屏标画"图标钮（V0.1.11）：
             方形小钮 + 四角扩展箭头，与胶囊按钮并排展示"放大画布"语义（比横向双向箭头更直观）。
             全部走 Theme* 主题键（禁写死色值）；FocusVisualStyle=Null（清 WPF 默认焦点虚线框）；
             键盘/读屏语义靠 ToolTip + AutomationProperties.Name。 -->
        <Style x:Key="RoiExpandButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Path x:Name="Glyph" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M4,9 V6 A2,2 0 0 1 6,4 H9  M15,4 H18 A2,2 0 0 1 20,6 V9  M20,15 V18 A2,2 0 0 1 18,20 H15  M9,20 H6 A2,2 0 0 1 4,18 V15"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="◈ 配方编辑器" Style="{StaticResource AiPageTitle}"/>
                <TextBlock Text="{Binding RecipeName}" Style="{StaticResource AiPageSub}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回配方中心" Command="{Binding BackCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"/>
                <Button Content="保存配方" Command="{Binding SaveCommand}"
                        Style="{StaticResource AiBtnPrimary}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左列：工步序列 + 编制顺序（设计稿 236px，align-self:start） ===== -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Border Style="{StaticResource AiCard}">
                    <StackPanel>
                        <Grid Margin="16,14,12,8">
                            <TextBlock Text="工步序列" Style="{StaticResource AiCardTitle}"/>
                            <Button Content="＋" Command="{Binding AddStepCommand}"
                                    Style="{StaticResource AiBtnGhostSm}" Width="26" Padding="0"
                                    HorizontalAlignment="Right" ToolTip="添加工步"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="6,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7" Margin="0,1" CornerRadius="8" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemePrimaryFill}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" Gesture="LeftClick"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextMuted}" TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource AiDivider}" Margin="14,10"/>
                        <Button Content="删除选中工步" Command="{Binding DeleteStepCommand}"
                                Style="{StaticResource AiBtnDangerSoftSm}" Margin="14,0,14,14"/>
                    </StackPanel>
                </Border>

                <!-- 编制顺序小卡（设计稿 .card .bd.tight 灰字清单） -->
                <Border Style="{StaticResource AiCard}" Margin="0,12,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="编制顺序" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextFg}"/>
                        <TextBlock Style="{StaticResource AiHint}" Margin="0,6,0,0" LineHeight="18">
                            <Run Text="① 工步名 + 预期零件（自然语言）"/><LineBreak/>
                            <Run Text="② 判定规则（IoU / 数量 / 稳定帧数）"/><LineBreak/>
                            <Run Text="③ ROI 标画（在实际取像上拖拽）"/><LineBreak/>
                            <Run Text="④ 保存 → 启用 → 监控台验证"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 右列：配置 / 规则 / ROI 标画（滚动） ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" Padding="0,0,4,0">
                <StackPanel>
                    <!-- 工步配置卡（设计稿 3 列：工步名 110 / 预期零件 / 预期变化；第二行 ROI + 检测要求） -->
                    <Border Style="{StaticResource AiCard}" Padding="18,14,18,16"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="工步配置" Style="{StaticResource AiCardTitle}"/>
                                <TextBlock Text="自然语言即检测类目" Style="{StaticResource AiCardSub}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="工步名" Style="{StaticResource AiFormLabel}"/>
                                    <TextBox Text="{Binding EditStepName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AiInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="预期零件" Style="{StaticResource AiFormLabel}"/>
                                    <TextBox Text="{Binding EditExpectedPart, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AiInput}" FontSize="13"
                                             BorderBrush="{DynamicResource ThemePrimary}" BorderThickness="1.5"
                                             ToolTip="一句话即指即检：换叫法、增减类目改这里即可，无需标注训练（平台核心卖点）"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="预期变化" Style="{StaticResource AiFormLabel}"/>
                                    <ComboBox SelectedIndex="{Binding EditExpectation}" Style="{StaticResource AiCombo}">
                                        <ComboBoxItem Style="{StaticResource AiComboItem}">出现（装配到位）</ComboBoxItem>
                                        <ComboBoxItem Style="{StaticResource AiComboItem}">消失（移除）</ComboBoxItem>
                                        <ComboBoxItem Style="{StaticResource AiComboItem}">整检（齐套）</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="用一句话描述，模型即指即检；改这句话就换检测目标，零训练"
                                       Style="{StaticResource AiFormHint}" Margin="124,5,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="判定区域" Style="{StaticResource AiFormLabel}"/>
                                    <ComboBox SelectedValue="{Binding EditRoiId}" SelectedValuePath="Tag"
                                              DisplayMemberPath="Content"
                                              ItemsSource="{Binding RoiChoices}"
                                              IsEnabled="{Binding CountEnabled}"
                                              Style="{StaticResource AiCombo}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource AiHint}"
                                           Margin="0,22,0,0" VerticalAlignment="Center"
                                           Text="判定只在本 ROI 内进行：框与 ROI 的 IoU 达标 + 连续稳定帧数满足才判 OK（整检步固定全画面）"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 判定规则卡 -->
                    <Border Style="{StaticResource AiCard}" Padding="18,14,18,16" Margin="0,14,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="判定规则" Style="{StaticResource AiCardTitle}"/>
                                    <TextBlock Text="确定性几何判定 · 可审计" Style="{StaticResource AiCardSub}" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="规则快照随审计存档，判定依据可复核" Style="{StaticResource AiCardSub}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="IoU 阈值" Style="{StaticResource AiFormLabel}"/>
                                    <TextBox Text="{Binding EditIoU, UpdateSourceTrigger=PropertyChanged, FallbackValue=0.35}"
                                             Style="{StaticResource AiInput}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="稳定帧数" Style="{StaticResource AiFormLabel}"/>
                                    <TextBox Text="{Binding EditStableFrames, UpdateSourceTrigger=PropertyChanged, FallbackValue=3}"
                                             Style="{StaticResource AiInput}"/>
                                </StackPanel>
                                <StackPanel IsEnabled="{Binding CountEnabled}">
                                    <TextBlock Text="数量校验（空=只判有无）" Style="{StaticResource AiFormLabel}"/>
                                    <TextBox Text="{Binding EditExpectedCountText, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                             Style="{StaticResource AiInput}"/>
                                </StackPanel>
                            </UniformGrid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="安全件双通道（检测 + 模板匹配一致才放行）"
                                           FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ToggleButton IsChecked="{Binding EditDualChannel}" Style="{StaticResource AiSwitch}"/>
                                    <TextBlock Text="启用" FontSize="11.5" Margin="8,0,0,0"
                                               Foreground="{DynamicResource ThemeTextFg}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ROI 标画卡（设计稿：卡头 + [画布 1fr | 右栏 300]） -->
                    <Border Style="{StaticResource AiCard}" Margin="0,14,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="18,14,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ROI 标画" Style="{StaticResource AiCardTitle}"/>
                                    <TextBlock Text="在实际取像上拖拽标定 · 拖框移动 / 拖角缩放 / 空白拖画新框"
                                               Style="{StaticResource AiCardSub}" Margin="8,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource RoiExpandButton}" Margin="0,0,8,0"
                                            Command="{Binding FullscreenRoiCommand}"
                                            ToolTip="全屏标画（单独弹窗，Esc 退出）"
                                            AutomationProperties.Name="全屏标画"/>
                                    <Button Content="{Binding PreviewToggleText}" Command="{Binding TogglePreviewCommand}"
                                            Style="{StaticResource AiBtnPrimarySm}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="18,12,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <!-- 画布视口：舞台按帧 4:3 内接居中（RoiStageController 计算尺寸）；
                                     脚注叠在舞台内部底边（设计稿 .stage-foot，不占卡外一行） -->
                                <Grid Grid.Column="0">
                                    <Border x:Name="RoiViewport" Background="{DynamicResource ThemePanel2Bg}"
                                            CornerRadius="12" Height="440" ClipToBounds="True">
                                        <Grid>
                                            <ui:KxImageStage x:Name="RoiStage"
                                                             GridStep="64" Background="Transparent"
                                                             Width="480" Height="360"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             FrameSource="{Binding FrameImage}"
                                                             GridVisibleWhenFrame="False"
                                                             IdleText="点「启动取像」出画面，然后在画面上拖拽标画 ROI…"/>
                                            <Border VerticalAlignment="Bottom" Height="26" CornerRadius="0,0,12,12"
                                                    Background="{DynamicResource ThemeStageFootBg}" Padding="12,0"
                                                    IsHitTestVisible="False">
                                                <Grid>
                                                    <TextBlock Text="帧画面 4:3 · 与监控台同比例" FontSize="10"
                                                               Foreground="{DynamicResource ThemeTextMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="0~1000 归一化 · 与监控台同源" FontSize="10"
                                                               Foreground="{DynamicResource ThemeTextMuted}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 右栏 300：选中 ROI 数值（2×2）+ 判定区域清单 + 说明 -->
                                <StackPanel Grid.Column="2">
                                    <!-- 选中 ROI 小卡 -->
                                    <Border Background="{DynamicResource ThemePanel2Bg}"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                            CornerRadius="12" Padding="12,11">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="选中 ROI" FontSize="10.5"
                                                           Foreground="{DynamicResource ThemeTextMuted}"
                                                           VerticalAlignment="Center"/>
                                                <ContentControl HorizontalAlignment="Right" Height="18" FontSize="10"
                                                                Style="{StaticResource AiChipPlainPri}"
                                                                Content="{Binding SelectedRoi.Id, FallbackValue='—'}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedRoi.Name, FallbackValue='未选择'}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThemeTextFg}"
                                                       Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="X" Style="{StaticResource AiFormLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedRoi.X, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}"
                                                             Style="{StaticResource AiInputSm}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2">
                                                    <TextBlock Text="Y" Style="{StaticResource AiFormLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedRoi.Y, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}"
                                                             Style="{StaticResource AiInputSm}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0">
                                                    <TextBlock Text="宽 W" Style="{StaticResource AiFormLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedRoi.W, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}"
                                                             Style="{StaticResource AiInputSm}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                    <TextBlock Text="高 H" Style="{StaticResource AiFormLabel}" Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding SelectedRoi.H, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}"
                                                             Style="{StaticResource AiInputSm}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 判定区域清单（设计稿：无阴影小卡 + ＋钮 + 选中主色行） -->
                                    <Border Style="{StaticResource AiCard}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="12,10,10,4">
                                                <TextBlock Text="判定区域" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource ThemeTextFg}"/>
                                                <Button Content="＋" Command="{Binding AddRoiCommand}"
                                                        Style="{StaticResource AiBtnGhostSm}" Width="24" Padding="0"
                                                        HorizontalAlignment="Right" ToolTip="添加 ROI"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Rois}" Margin="6,0,6,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,5" Margin="0,1" CornerRadius="7" Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ThemePrimaryFill}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding Command="{Binding DataContext.SelectRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}" Gesture="LeftClick"/>
                                                            </Border.InputBindings>
                                                            <TextBlock Text="{Binding Display}" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="删除选中 ROI" Command="{Binding DeleteRoiCommand}"
                                                    Style="{StaticResource AiBtnDangerSoftSm}"
                                                    Margin="10,8,10,10"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource AiHint}" Margin="2,10,0,0" LineHeight="18">
                                        <Run Text="颜色：橙实线 = 选中（四角手柄）｜灰实线 = 未选中"/><LineBreak/>
                                        <Run Text="全屏标画 = 独立弹窗（Esc 退出），与编辑器实时同步"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 未选中工步占位（HasSelection=false 时可见） -->
                    <Border Padding="40">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AiCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="左侧选择一个工步开始编辑" FontSize="13"
                                   Foreground="{DynamicResource ThemeTextMuted}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
