<!--
  配方编辑器（设计稿 data-page="editor" · C 方案）

  ┌ 页头：◈ 配方编辑器 · 配方名        [← 返回配方中心] [保存配方(primary)] ┐
  ├──────────────┬────────────────────────────────────────────────────┤
  │ 工步序列卡    │ 工步配置卡：工步名 / 预期零件(自然语言,主色描边)      │
  │ (选中高亮)    │            预期变化 / 判定区域                       │
  │ [+ 添加工步]  │ 判定规则卡：IoU 阈值 / 稳定帧数 / 数量 / 双通道开关   │
  │ ROI 清单卡    │ ROI 标画卡：KxImageStage 取像 + 拖拽标画 + 数值编辑   │
  └──────────────┴────────────────────────────────────────────────────┘
  自然语言预期零件是本页核心（改一句话换检测目标，零训练）。
  V0.1.7：ROI 预览升级为"在实际取像上拖拽标画"（KxImageStage 同监控台取像控件，
  启动取像只开相机不做检测；拖框移动/拖角缩放/空白画新框，数值双向联动）。
-->
<UserControl x:Class="AIris.WPF.Views.RecipeEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" xmlns:converters="clr-namespace:AIris.WPF.Converters"/>

        <!-- ROI 画布"全屏标画"图标钮（V0.1.11）：
             方形小钮 + 四角扩展箭头，与胶囊按钮并排展示"放大画布"语义（比横向双向箭头更直观）。
             全部走 Theme* 主题键（禁写死色值）；FocusVisualStyle=Null（清 WPF 默认焦点虚线框）；
             键盘/读屏语义靠 ToolTip + AutomationProperties.Name。 -->
        <Style x:Key="RoiExpandButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Path x:Name="Glyph" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M4,9 V6 A2,2 0 0 1 6,4 H9  M15,4 H18 A2,2 0 0 1 20,6 V9  M20,15 V18 A2,2 0 0 1 18,20 H15  M9,20 H6 A2,2 0 0 1 4,18 V15"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="◈ 配方编辑器" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                <TextBlock Text="{Binding RecipeName}" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回配方中心" Command="{Binding BackCommand}" Style="{DynamicResource FreshButton}"
                        FontSize="12" Padding="14,7" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="保存配方" Command="{Binding SaveCommand}" Style="{DynamicResource FreshPrimaryButton}"
                        FontSize="12" Padding="18,7" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左列：工步序列 + ROI 清单 ===== -->
            <StackPanel Grid.Column="0">
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="4,4,4,10">
                    <StackPanel>
                        <Grid Margin="12,10,12,6">
                            <TextBlock Text="工步序列" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <Button Content="＋" Command="{Binding AddStepCommand}" Style="{DynamicResource FreshButton}"
                                    FontSize="12" Padding="8,2" HorizontalAlignment="Right" Cursor="Hand" ToolTip="添加工步"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,6" Margin="4,1" CornerRadius="8" Background="{Binding BgKey}" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" Gesture="LeftClick"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ThemeTextFg}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="删除选中工步" Command="{Binding DeleteStepCommand}" Style="{DynamicResource FreshDangerButton}"
                                FontSize="11" Padding="10,4" Margin="12,8,12,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="4,4,4,10" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="12,10,12,6">
                            <TextBlock Text="判定区域（ROI，0~1000 归一化）" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <Button Content="＋" Command="{Binding AddRoiCommand}" Style="{DynamicResource FreshButton}"
                                    FontSize="12" Padding="8,2" HorizontalAlignment="Right" Cursor="Hand" ToolTip="添加 ROI"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rois}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,6" Margin="4,1" CornerRadius="8" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <!-- 选中高亮绑 VM.IsSelected（旧写法绑 ContentPresenter.IsSelected
                                                         属性不存在恒不触发，选中行从未高亮过——2026-11-22 修复） -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.SelectRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" Gesture="LeftClick"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding Display}" FontSize="11.5" Foreground="{DynamicResource ThemeTextFg}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="删除选中 ROI" Command="{Binding DeleteRoiCommand}" Style="{DynamicResource FreshDangerButton}"
                                FontSize="11" Padding="10,4" Margin="12,8,12,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 右列：工步配置 + 判定规则 + ROI 数值 =====
                 2026-11-23：外层套 ScrollViewer——ROI 画布改为按画面比例内接（最大 380 高），
                 小屏/高缩放时整列可滚动，不再把下方数值行挤出窗口。 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" Padding="0,0,4,0">
            <StackPanel>
                <!-- 工步配置卡 -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="工步配置" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="工步名" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditStepName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="预期零件" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top" Margin="0,14,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox Text="{Binding EditExpectedPart, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource FreshInput}" FontSize="13" Padding="10,0" Margin="0,3"
                                         BorderBrush="{DynamicResource ThemePrimary}" BorderThickness="1.5"
                                         ToolTip="一句话即指即检：换叫法、增减类目改这里即可，无需标注训练（平台核心卖点）"/>
                                <TextBlock Text="用一句话描述，模型即指即检；改这句话就换检测目标，零训练" FontSize="10.5"
                                           Foreground="{DynamicResource ThemeTextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="预期变化" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" SelectedIndex="{Binding EditExpectation}" Style="{DynamicResource FreshCombo}" FontSize="12" Padding="10,7">
                                    <ComboBoxItem>出现（装配到位）</ComboBoxItem>
                                    <ComboBoxItem>消失（移除）</ComboBoxItem>
                                    <ComboBoxItem>整检（齐套）</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Grid.Column="1" Text="" />
                                <ComboBox Grid.Column="2" Style="{DynamicResource FreshCombo}" FontSize="12" Padding="10,7"
                                          SelectedValue="{Binding EditRoiId}" SelectedValuePath="Tag" IsEnabled="{Binding CountEnabled}"
                                          ItemsSource="{Binding RoiChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 判定规则卡 -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="判定规则（确定性几何判定 · 可审计）" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}"/>
                            <TextBlock Text="规则快照随审计存档，判定依据可复核" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="IoU 阈值" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding EditIoU, UpdateSourceTrigger=PropertyChanged, FallbackValue=0.35}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="稳定帧数" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding EditStableFrames, UpdateSourceTrigger=PropertyChanged, FallbackValue=3}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"/>
                            </StackPanel>
                            <StackPanel IsEnabled="{Binding CountEnabled}">
                                <TextBlock Text="数量校验（空=只判有无）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <TextBox Text="{Binding EditExpectedCountText, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{DynamicResource FreshInput}" FontSize="12.5" Padding="10,0" Margin="0,4"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="安全件双通道（检测 + 模板匹配一致才放行）" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding EditDualChannel}" HorizontalAlignment="Right" Content="启用" FontSize="11.5" Foreground="{DynamicResource ThemeTextFg}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ROI 预览卡（V0.1.7：取像舞台 KxImageStage 实时画面 + 鼠标拖拽标画 ROI。
                     启动取像 = 只开相机不做检测（RunMonitor.StartPreview），画面上：
                     拖框移动 / 四角手柄缩放 / 空白拖画新框；右侧 X/Y/W/H 数值双向联动） -->
                <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="18,14" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ROI 标画（在实际取像上拖拽标定）" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextFg}" VerticalAlignment="Center"/>
                                <TextBlock Text="拖框移动 · 拖角缩放 · 空白拖画新框" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="12,1,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 全屏标画：单独弹窗放大画布（ROI 仍双向联动，Esc 退出） -->
                                <Button Style="{StaticResource RoiExpandButton}" Margin="0,0,8,0"
                                        Command="{Binding FullscreenRoiCommand}"
                                        ToolTip="全屏标画（单独弹窗，Esc 退出）"
                                        AutomationProperties.Name="全屏标画"/>
                                <Button Content="{Binding PreviewToggleText}" Command="{Binding TogglePreviewCommand}"
                                        Style="{DynamicResource FreshPrimaryButton}" FontSize="11.5" Padding="14,5"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        <!-- 画布视口：舞台（KxImageStage）按画面比例内接其中并居中（RoiStageController 计算尺寸），
                             视口放不下自动等比缩小、富余自动放大——与主界面监控画面同比例，ROI 不再随超宽条变形。 -->
                        <Border x:Name="RoiViewport" Background="{DynamicResource ThemePanel2Bg}" CornerRadius="12"
                                Height="380" Margin="0,10,0,0" ClipToBounds="True">
                            <ui:KxImageStage x:Name="RoiStage" xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
                                             GridStep="64" Background="Transparent"
                                             Width="480" Height="360"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             FrameSource="{Binding FrameImage}" IdleText="点「启动取像」出画面，然后在画面上拖拽标画 ROI…"/>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="选中：" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedRoi.Display, FallbackValue='—'}" FontSize="11.5" Foreground="{DynamicResource ThemeTextFg}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="4" HorizontalAlignment="Right" MaxWidth="420">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="X" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBox Text="{Binding SelectedRoi.X, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" Style="{DynamicResource FreshInput}" FontSize="11.5" Padding="8,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Y" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBox Text="{Binding SelectedRoi.Y, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" Style="{DynamicResource FreshInput}" FontSize="11.5" Padding="8,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="宽 W" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBox Text="{Binding SelectedRoi.W, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" Style="{DynamicResource FreshInput}" FontSize="11.5" Padding="8,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="高 H" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBox Text="{Binding SelectedRoi.H, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" Style="{DynamicResource FreshInput}" FontSize="11.5" Padding="8,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
