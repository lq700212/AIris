<!--
  设备与集成（设计稿 data-page="settings" · C 方案）

  ┌ 页头：⚙ 设备与集成 · 相机/光源/引导屏/声光/MES   [← 返回监控台] [保存] ┐
  ├──────────────┬────────────────────────────────────────────────────────┤
  │ 设备列表 236  │ 连接参数卡：相机IP(*) / 端口(130) / 曝光(*)             │
  │ align-self:   │            光源亮度滑块(*) / MES 地址(*)                │
  │ start         │            ── 分隔 ──                                  │
  │ 每行=状态点   │ [Mock 数据模式提示条]（仅 MockMode=True）                │
  │ +名称         │ 连接参数卡：相机类型 / IP / RTSP 端口 / 通道 / 曝光      │
  │ 在线绿/离线灰 ├────────────────────────────────────────────────────────┤
  │ /未配置橙     │ 保存即应用说明 + [采集测试帧]                            │
  └──────────────┴────────────────────────────────────────────────────────┘

  vNext 落地（2026-11-23 整改）：
  · 左导航每行前加 6px 连接状态点（在线 ThemeOk / 离线 ThemeTextMuted / 未配置 ThemeWarn），
    状态来自 VM.RefreshStatus()，保存参数后实时刷新（不是硬编码装饰）；
  · 左卡 align-self:start 不再撑满整列（旧版底部大片空盒）；
  · 表单按设计稿重排：首行 IP+端口(130)+曝光，第二行滑块+MES，复选框区 2×2；
  · 滑块用宿主 AiSlider（6px 药丸轨道 + 主→粉渐变 + 16px 圆钮）。
  2026-11-28 收口：相机类型只保留 RTSP / 海康 GigE 两档真实设备；
  「Mock 合成画面」已收口为顶栏「Mock 数据」全局开关（相机 + 引擎一起切演示数据），
  MockMode 期间本页参数照常保存，但相机保持合成画面、关闭 Mock 后生效。
-->
<UserControl x:Class="AIris.WPF.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙ 设备与集成" Style="{StaticResource AiPageTitle}"/>
                <TextBlock Text="相机 / 光源 / 引导屏 / 声光报警 / MES" Style="{StaticResource AiPageSub}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← 返回监控台" Command="{Binding BackCommand}"
                        Style="{StaticResource AiBtnSecondary}" Margin="0,0,10,0"/>
                <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource AiBtnPrimary}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设备列表（align-self:start，行 = 状态点 + 名称） ===== -->
            <Border Grid.Column="0" Style="{StaticResource AiCard}" Padding="10" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Devices}" SelectedIndex="{Binding SelectedDevice}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="9" Padding="10,8" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryFill}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding StatusText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 连接状态点 6px（在线绿 / 离线灰 / 未配置橙） -->
                                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ThemeWarn}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                    <Setter Property="Fill" Value="{DynamicResource ThemeOk}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Fill" Value="{DynamicResource ThemeTextMuted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ===== 右：Mock 提示条 + 参数卡 + 底部动作条 ===== -->
            <StackPanel Grid.Column="2">
                <!-- Mock 数据模式提示条：参数可编辑可保存，但相机保持合成画面（关闭 Mock 后生效） -->
                <Border Background="{DynamicResource ThemeWarnDim}" CornerRadius="10"
                        Padding="14,9" Margin="0,0,0,12"
                        Visibility="{Binding IsMockMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mock 数据模式" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeWarn}" VerticalAlignment="Center"/>
                        <TextBlock Text="相机当前使用合成画面；下方真实相机参数可照常保存，关闭顶栏「Mock 数据」后立即生效。"
                                   FontSize="11" Foreground="{DynamicResource ThemeWarn}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AiCard}" Padding="18,14,18,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="连接参数" Style="{StaticResource AiCardTitle}"/>
                            <TextBlock Text="{Binding SelectedDeviceName, FallbackValue=GigE 相机 · 海康}"
                                       Style="{StaticResource AiCardSub}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 首行：相机类型 + 相机 IP（类型决定采集链路，保存即热切换） -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="相机类型" Style="{StaticResource AiFormLabel}"/>
                                <ComboBox SelectedIndex="{Binding CameraKindIndex}" Style="{StaticResource AiCombo}"
                                          ToolTip="RTSP=网络相机（安格华等）；GigE=海康 SDK。Mock 演示请用顶栏「Mock 数据」开关">
                                    <ComboBoxItem Content="RTSP 网络相机"/>
                                    <ComboBoxItem Content="海康 GigE 相机"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="相机 IP" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding CameraIp, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AiInput}" ToolTip="网络相机 IP（如 192.168.1.188）；GigE 用于枚举连接"/>
                            </StackPanel>
                        </Grid>

                        <!-- 第二行：RTSP 端口 + 通道 + 曝光（曝光仅 GigE 有效） -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RTSP 端口" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding CameraPort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AiInput}" ToolTip="RTSP 标准端口 554（相机端不改端口就填 554）"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RTSP 通道" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding RtspChannel, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AiInput}" ToolTip="安格华相机通道号（stream{channel}），0 起"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="曝光（μs，仅 GigE）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding ExposureUs, UpdateSourceTrigger=PropertyChanged, FallbackValue=8000}"
                                         Style="{StaticResource AiInput}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 第三行：RTSP 地址模板（整行；换品牌只改模板不改代码） -->
                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="RTSP 地址模板" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding RtspUrlFormat, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="占位符 {ip} {port} {channel}；安格华默认 rtsp://{ip}:{port}/stream{channel}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 第二行：光源亮度滑块 + MES 地址 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="光源通道 1 · 亮度" Style="{StaticResource AiFormLabel}"/>
                                <Grid Margin="0,0,26,0">
                                    <Slider Value="{Binding LightBrightness, FallbackValue=72}"
                                            Minimum="0" Maximum="100" Style="{StaticResource AiSlider}"/>
                                    <TextBlock Text="{Binding LightBrightness, FallbackValue=72}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextFg}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MES 接口地址（HTTP）" Style="{StaticResource AiFormLabel}"/>
                                <TextBox Text="{Binding MesUrl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         Style="{StaticResource AiInput}"
                                         ToolTip="示例：http://mes.local/api/v1/inspect（留空 = 不接入 MES）"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource AiDivider}" Margin="0,14"/>

                        <!-- 复选框 2×2（框左字右，AiCheckBox 对位库 KxCheckBox 形态） -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding DiffuserOn}"
                                      Style="{StaticResource AiCheckBox}" Content="漫射罩常开（防金属反光）"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding GuideScreenOn}"
                                      Style="{StaticResource AiCheckBox}" Content="引导屏同步工步文案"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding BeaconOn}"
                                      Style="{StaticResource AiCheckBox}" Content="三色声光报警灯"
                                      Margin="0,10,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding MesEnabled}"
                                      Style="{StaticResource AiCheckBox}" Content="MES 判定结果上报"
                                      Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 底部动作条（保存即热切换说明 + 采集测试帧） -->
                <Border Style="{StaticResource AiCard}" Margin="0,14,0,0" Padding="14,10">
                    <Grid>
                        <TextBlock Text="保存即应用：相机类型可随时切换（RTSP ↔ GigE），不用重启程序；Mock 演示用顶栏「Mock 数据」开关"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                                   VerticalAlignment="Center"/>
                        <Button Content="采集测试帧" Command="{Binding TestCameraCommand}"
                                Style="{StaticResource AiBtnSecondarySm}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
