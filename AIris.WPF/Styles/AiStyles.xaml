<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AIris.WPF.Converters">

    <!--
      【药丸圆角唯一正解：PillRadius 转换器（2026-11-23 用户反馈"胶囊太尖锐"整改）】
      WPF 的 CornerRadius="999" ≠ CSS 的 border-radius:999px：
        CSS 会把半径统一缩到 高度/2，端头是正圆半圆（设计稿形状）；
        WPF 则水平钳到 宽/2、垂直钳到 高/2，画出椭圆角——宽按钮两端被拉长、
        收弧太急，视觉上就是"尖锐/橄榄球"。实测同 32 高按钮 r=999 顶部行宽
        只有 0.23 倍（椭圆），r=16 则是 0.74 倍（正圆 + 直边）= 设计稿形状。
      所以本字典所有药丸模板一律写成：
        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self},
                       Converter={StaticResource PillRadius}}"
      这样任何 DPI / 字体放大 / 窗口比例下圆角恒等于实际半高，永远是正圆药丸，
      既还原设计稿弧度，又满足"基类控件复用不变形"。
      注：卡片 16 / 内卡 12 / 输入 10 是设计稿固定圆角，不走本转换器。
    -->
    <conv:PillRadiusConverter x:Key="PillRadius"/>

    <!--
      AIris 宿主共享样式（C 方案「熔金流场」组件层）—— 2026-11-23 全面对齐设计稿新增。

      为什么单独一份字典而不是塞进 ThemeLight/ThemeDark：
        · 颜色全部走 DynamicResource Theme* 键 → 明暗主题切换自动跟随，本字典不需两套；
        · 组件形态（圆角/高度/内距）是设计稿常量，与主题无关；
        · ThemeService 只替换 ThemeLight↔ThemeDark 两个字典，本字典排在其后始终生效。

      落地口径（docs/ui_design_mockups.html）：
        · 卡片 16 圆角 / 内卡 12 / 输入 10 / 按钮与胶囊 = 半高圆角药丸（PillRadius）；
        · 页头标题 20 Bold + 副题 12 muted；
        · 表单项 label 11 muted（下距 5）+ 输入高 34；
        · 状态胶囊高 22，6px 圆点；
        · 按钮主 32 高（sm 26 高）。全部按钮/输入/开关 FocusVisualStyle=Null
          （WPF 默认焦点虚线框是"药丸按钮效果奇怪"的元凶，见 AGENTS.md 铁律 10）。
    -->

    <!-- ============================================================
         1. 文本
         ============================================================ -->
    <Style x:Key="AiPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AiPageSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AiCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AiCardSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AiHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style x:Key="AiFormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="AiFormHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15"/>
    </Style>

    <!-- ============================================================
         2. 卡片
         ============================================================ -->
    <Style x:Key="AiCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <!-- 设计稿卡片有极淡投影；软件渲染下大面积 Effect 会拖帧，统一用边框+圆角表达层次 -->
    </Style>

    <Style x:Key="AiCardInner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- 页脚说明条（整宽浅底小字条） -->
    <Style x:Key="AiFootBar" TargetType="Border" BasedOn="{StaticResource AiCard}">
        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="AiDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- ============================================================
         3. 按钮（药丸 = 半高圆角，见文件头 PillRadius 说明）
         ============================================================ -->
    <Style x:Key="AiBtn" TargetType="Button">
        <!-- 屏幕适配（2026-11-23）：MinHeight 而非固定 Height——任何 DPI/字体缩放/
             窗口比例下胶囊只会整体变高；圆角绑 ActualHeight/2 同步变半高，始终正圆药丸 -->
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：主色实底 + 白字 -->
    <Style x:Key="AiBtnPrimary" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemePrimaryHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemePrimaryPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 次按钮：面板底 + 描边，hover 主色描边主色字 -->
    <Style x:Key="AiBtnSecondary" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemePrimaryFill}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危险实底（NG 模拟/删除） -->
    <Style x:Key="AiBtnDanger" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="{DynamicResource ThemeNg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危险弱化（删除配方/ROI：浅红底红字） -->
    <Style x:Key="AiBtnDangerSoft" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeNg}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 幽灵按钮：透明底 + 描边 muted 字 -->
    <Style x:Key="AiBtnGhost" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 幽灵危险：透明底 + 红字红边，hover 浅红底（设计稿 .btn.ghost 的 NG 变体——
         监控页「拿走一个（NG 模拟）」是演示动作而非主操作，红实底（AiBtnDanger）过重，
         会把"主按钮=重检本步"的视觉层级压掉） -->
    <Style x:Key="AiBtnDangerGhost" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeNg}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 小号（26 高）三档：内容密集区/卡片脚操作 -->
    <Style x:Key="AiBtnSm" TargetType="Button" BasedOn="{StaticResource AiBtn}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnPrimarySm" TargetType="Button" BasedOn="{StaticResource AiBtnPrimary}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnSecondarySm" TargetType="Button" BasedOn="{StaticResource AiBtnSecondary}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnDangerSm" TargetType="Button" BasedOn="{StaticResource AiBtnDanger}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnDangerSoftSm" TargetType="Button" BasedOn="{StaticResource AiBtnDangerSoft}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnDangerGhostSm" TargetType="Button" BasedOn="{StaticResource AiBtnDangerGhost}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="AiBtnGhostSm" TargetType="Button" BasedOn="{StaticResource AiBtnGhost}">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- ============================================================
         4. 输入（高 34 / 圆角 10 / focus 主色描边）
         ============================================================ -->
    <Style x:Key="AiInput" TargetType="TextBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- 红线：TextBox 垂直 Padding 必须为 0（垂直内缩会裁掉文本行），居中靠 VerticalContentAlignment -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只读/无边框输入（卡片内联数值） -->
    <Style x:Key="AiInputSm" TargetType="TextBox" BasedOn="{StaticResource AiInput}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- 下拉选项容器 -->
    <Style x:Key="AiComboItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <!-- ALT 键焦点虚线框：下拉项选中后按 ALT 会画出默认虚线，与自绘圆角项冲突 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框（高 34 / 圆角 10 / 自绘箭头 + Popup 卡片） -->
    <Style x:Key="AiCombo" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AiComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="12,0,2,0"
                                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource ThemeTextMuted}"
                                      StrokeThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsHitTestVisible="False" Margin="0,1,0,0"/>
                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                               Focusable="False" StaysOpen="False">
                            <Border Background="{DynamicResource ThemePanelBg}"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    CornerRadius="12" Padding="4" Margin="0,5,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         5. 状态胶囊（ContentControl：6px 圆点 + 文本）
         ============================================================ -->
    <Style x:Key="AiChipBase" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                     Fill="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无圆点胶囊（许可证/未启用等纯文字标签） -->
    <Style x:Key="AiChipPlain" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AiChipOk" TargetType="ContentControl" BasedOn="{StaticResource AiChipBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
    </Style>
    <Style x:Key="AiChipNg" TargetType="ContentControl" BasedOn="{StaticResource AiChipBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
    </Style>
    <Style x:Key="AiChipWarn" TargetType="ContentControl" BasedOn="{StaticResource AiChipBase}">
        <Setter Property="Background" Value="{DynamicResource ThemeWarnDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeWarn}"/>
    </Style>
    <Style x:Key="AiChipMut" TargetType="ContentControl" BasedOn="{StaticResource AiChipBase}">
        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="AiChipPri" TargetType="ContentControl" BasedOn="{StaticResource AiChipBase}">
        <Setter Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
    </Style>

    <Style x:Key="AiChipPlainOk" TargetType="ContentControl" BasedOn="{StaticResource AiChipPlain}">
        <Setter Property="Background" Value="{DynamicResource ThemeOkDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeOk}"/>
    </Style>
    <Style x:Key="AiChipPlainNg" TargetType="ContentControl" BasedOn="{StaticResource AiChipPlain}">
        <Setter Property="Background" Value="{DynamicResource ThemeNgDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeNg}"/>
    </Style>
    <Style x:Key="AiChipPlainWarn" TargetType="ContentControl" BasedOn="{StaticResource AiChipPlain}">
        <Setter Property="Background" Value="{DynamicResource ThemeWarnDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeWarn}"/>
    </Style>
    <Style x:Key="AiChipPlainMut" TargetType="ContentControl" BasedOn="{StaticResource AiChipPlain}">
        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="AiChipPlainPri" TargetType="ContentControl" BasedOn="{StaticResource AiChipPlain}">
        <Setter Property="Background" Value="{DynamicResource ThemePrimaryDim}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
    </Style>

    <!-- ============================================================
         6. KPI 卡（内卡底 + 小标签 + 大数值）
         ============================================================ -->
    <Style x:Key="AiKpi" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemePanel2Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,16"/>
    </Style>
    <Style x:Key="AiKpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
    </Style>
    <Style x:Key="AiKpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="AiKpiValueSm" TargetType="TextBlock" BasedOn="{StaticResource AiKpiValue}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============================================================
         7. 开关（40×22 药丸轨道 + 18 圆钮，无 on/off 文字）
         ============================================================ -->
    <Style x:Key="AiSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <!-- 未选中轨道用 ThemeBorder 实色：ThemePanel2Bg 深色下与卡片底几乎同色，
                             2026-11-23 深色目检实测只剩一个白圆点看不出"这是个开关" -->
                        <Border x:Name="Track" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                                Background="{DynamicResource ThemeBorder}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1"
                                                  Direction="270" Opacity="0.22"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemePrimaryGrad}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         8. 亮度滑块（6px 药丸轨道，已填充段主色渐变，16 圆形钮）
         ============================================================ -->
    <Style x:Key="AiSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Margin="0,0,10,0"
                                Background="{DynamicResource ThemePanel2Bg}"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>
                        <Track x:Name="PART_Track" Margin="0,0,10,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                                                    Background="{DynamicResource ThemePrimaryGrad}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource ThemePanelBg}"
                                                     Stroke="{DynamicResource ThemePrimary}" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         9. 复选框（15px 方框 + 右侧文字，形态对位库 KxCheckBox）
         为什么自绘而不 BasedOn KxCheckBox：库模板全部引用 Brush.Shell.* 契约键，
         主题热切换时库键板不跟着换（宿主只换 ThemeLight/Dark），深色下勾选框会停在浅色；
         自绘后颜色走 Theme*，两套主题一致。形态/尺寸与库完全同口径，不破坏视觉一致性。
         ============================================================ -->
    <Style x:Key="AiCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextFg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.4"
                                Background="Transparent" VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="✓" FontSize="10"
                                       Foreground="{DynamicResource ThemeOnPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemePrimaryGrad}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ============================================================
         10. 全局焦点虚线框清理（2026-11-28 ALT 键实训）

         【现象】按 ALT 键时引擎页/审计页出现一圈虚线框。
         【根因】鼠标点过某个可聚焦元素后，该元素持有键盘焦点但不画焦点框；
                一旦按 ALT（键盘输入），WPF 立即为当前焦点元素补画默认
                FocusVisualStyle（黑色虚线 Adorner），与自绘视觉格格不入。
                项目里按钮/输入框等**操作控件**早已逐个清掉，漏的是**容器类**：
                ScrollViewer 默认可聚焦（方向键滚动）、ItemsControl 的项容器
                ContentPresenter 也可能接焦点，于是整块内容区被画上一圈虚线。
         【口径】本项目容器不参与键盘导航（页面切换走顶栏胶囊），
                容器一律 Focusable=False + FocusVisualStyle=Null；
                操作控件（Button/TextBox/ComboBox）只清 FocusVisualStyle、
                保留 Focusable（无障碍键盘可达）。
         【边界】只给**库里没有隐式样式**的类型加隐式样式——隐式样式是整类替换，
                若库已有同类型隐式样式（如 ShellStyles 的 ListBoxItem/ComboBoxItem），
                在这里再写会把库外观冲掉，那两类改用显式样式逐个清（AiComboItem 已清）。
         ============================================================ -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ContentPresenter">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

</ResourceDictionary>
